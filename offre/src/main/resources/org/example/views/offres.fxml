<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.OffresController"
            stylesheets="@/org/example/styles/styleoffre.css">

    <!-- ================= LEFT SIDEBAR ================= -->
    <left>
        <VBox styleClass="sidebar"
              spacing="25"
              alignment="TOP_CENTER"
              prefWidth="90">

            <padding>
                <Insets top="25" right="15" bottom="25" left="15"/>
            </padding>

            <!-- Logo -->
            <ImageView fitWidth="50" fitHeight="50" preserveRatio="true">
                <image>
                    <Image url="@/org/example/images/VOS 1.png"/>
                </image>
            </ImageView>

            <!-- Navigation -->
            <VBox spacing="20"
                  alignment="TOP_CENTER"
                  VBox.vgrow="ALWAYS">

                <VBox alignment="CENTER" style="-fx-padding: 13;">
                    <ImageView fitWidth="24" fitHeight="24" preserveRatio="true">
                        <image>
                            <Image url="@/org/example/images/iconoir_bag.png"/>
                        </image>
                    </ImageView>
                </VBox>

                <Button styleClass="sidebar-btn">
                    <graphic>
                        <ImageView fitWidth="24" fitHeight="24" preserveRatio="true">
                            <image>
                                <Image url="@/org/example/images/bxs_chat.png"/>
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
            </VBox>

            <!-- Profile -->
            <Button styleClass="sidebar-btn">
                <graphic>
                    <Label text="👤" styleClass="sidebar-icon"/>
                </graphic>
            </Button>

        </VBox>
    </left>

    <!-- ================= MAIN CONTENT ================= -->
    <center>
        <StackPane fx:id="mainStack">
            
            <!-- ================= GRID VIEW ================= -->
            <VBox fx:id="gridView" spacing="30"
                  alignment="TOP_CENTER"
                  style="-fx-padding: 30;">

                <!-- ================= HERO ================= -->
                <VBox styleClass="hero"
                      spacing="50"
                      alignment="CENTER"
                      maxWidth="900">

                    <padding>
                        <Insets top="40" right="50" bottom="40" left="50"/>
                    </padding>

                    <Label text="Trouvez votre prochain emploi"
                           styleClass="hero-title"/>

                    <Label fx:id="heroSubtitle"
                           text="Découvrez 9 opportunités de carrière"
                           styleClass="hero-subtitle"/>
                </VBox>

                <!-- ================= SEARCH CONTAINER ================= -->
                <VBox styleClass="search-container"
                      spacing="20"
                      maxWidth="900">

                    <padding>
                        <Insets top="20" right="25" bottom="20" left="25"/>
                    </padding>

                    <Label text="Titre du poste"
                           styleClass="search-label"/>

                    <HBox alignment="CENTER_LEFT"
                          spacing="10">

                        <Label text="🔍"
                               style="-fx-font-size: 18px; -fx-text-fill: #999;"/>

                        <TextField fx:id="searchField"
                                   promptText="Frontend Developer, FullStack ..."
                                   styleClass="search-field"
                                   HBox.hgrow="ALWAYS"/>
                    </HBox>

                </VBox>

                <!-- ================= CARDS CONTAINER ================= -->
                <VBox maxWidth="900" alignment="TOP_LEFT">
                    <FlowPane fx:id="cardsContainer"
                              alignment="TOP_LEFT"
                              hgap="25"
                              vgap="25" />
                </VBox>

            </VBox>

            <!-- ================= DETAIL VIEW ================= -->
            <HBox fx:id="detailView" visible="false" managed="false" spacing="0" style="-fx-background-color: #f8fafc;">
                
                <!-- Jobs List Sidebar -->
                <VBox styleClass="jobs-sidebar" prefWidth="400" style="-fx-background-color: white; -fx-padding: 25 20 30 20; -fx-border-color: #e5e7eb; -fx-border-width: 0 1 0 0; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 15, 0, 2, 0);">
                    
                    <!-- Back Button -->
                    <Button text="← Retour aux offres" onAction="#backToGrid" styleClass="back-button"/>
                    
                    <Label text="Sélection d'offres pour vous" styleClass="sidebar-list-title" style="-fx-padding: 15 0 5 0;"/>
                    <Label text="Les postes les plus pertinents par rapport à votre expérience actuelle." 
                           styleClass="sidebar-list-subtitle" wrapText="true" style="-fx-padding: 0 0 15 0;"/>
                    
                    <ScrollPane fx:id="jobsListScroll" fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                        <VBox fx:id="jobsList" spacing="12" style="-fx-padding: 5 0 0 0;"/>
                    </ScrollPane>
                </VBox>
                
                <!-- Job Detail Panel -->
                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 0;" HBox.hgrow="ALWAYS">
                    <VBox fx:id="jobDetailPanel" spacing="20" style="-fx-padding: 40 60 50 60; -fx-background-color: white; -fx-max-width: 1000;">
                        <!-- Detail content will be populated dynamically -->
                    </VBox>
                </ScrollPane>
                
            </HBox>

        </StackPane>
    </center>

</BorderPane>
