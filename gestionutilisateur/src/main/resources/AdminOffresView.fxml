<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>

<BorderPane prefHeight="800.0" prefWidth="1400.0"
            stylesheets="@styles/modern.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.AdminOffresController">

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox fx:id="sidebar" styleClass="sidebar" prefWidth="90.0"
              style="-fx-background-color: white; -fx-border-color: #E5E7EB; -fx-border-width: 0 1 0 0;">
            <!-- Logo -->
            <VBox alignment="CENTER" styleClass="logo-container" style="-fx-padding: 30 0 30 0;">
                <Label text="VOS" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                <Label fx:id="sidebarSubtitle" text="Bâtir l'avenir avec vous!" 
                       style="-fx-text-fill: #6b7280; -fx-font-size: 10px; -fx-padding: 8 0 0 0; -fx-font-weight: 500; -fx-opacity: 0; -fx-max-width: 0;"/>
            </VBox>

            <!-- Navigation Icons -->
            <VBox fx:id="navContainer" alignment="TOP_LEFT" spacing="8.0" VBox.vgrow="ALWAYS" style="-fx-padding: 20 15 20 15;">

                <HBox fx:id="navStatistiques" alignment="CENTER_LEFT" spacing="15" 
                      style="-fx-background-color: transparent; -fx-padding: 12 15; -fx-cursor: hand; -fx-background-radius: 12;">
                    <Label text="📊" style="-fx-text-fill: #1f2937; -fx-font-size: 22px; -fx-min-width: 24; -fx-min-height: 24; -fx-alignment: center;"/>
                    <Label fx:id="labelStatistiques" text="Statistiques" 
                           style="-fx-text-fill: #1f2937; -fx-font-size: 14px; -fx-font-weight: 500; -fx-opacity: 0; -fx-max-width: 0;"/>
                </HBox>
                
                <HBox fx:id="navOpportunites" alignment="CENTER_LEFT" spacing="15" 
                      style="-fx-background-color: transparent; -fx-padding: 12 15; -fx-cursor: hand; -fx-background-radius: 12;">
                    <Label text="💼" style="-fx-text-fill: #1f2937; -fx-font-size: 22px; -fx-min-width: 24; -fx-min-height: 24; -fx-alignment: center;"/>
                    <Label fx:id="labelOpportunites" text="Opportunités" 
                           style="-fx-text-fill: #1f2937; -fx-font-size: 14px; -fx-font-weight: 500; -fx-opacity: 0; -fx-max-width: 0;"/>
                </HBox>
                
                <HBox fx:id="navApropos" alignment="CENTER_LEFT" spacing="15" 
                      style="-fx-background-color: transparent; -fx-padding: 12 15; -fx-cursor: hand; -fx-background-radius: 12;">
                    <Label text="ℹ️" style="-fx-text-fill: #1f2937; -fx-font-size: 22px; -fx-min-width: 24; -fx-min-height: 24; -fx-alignment: center;"/>
                    <Label fx:id="labelApropos" text="À propos" 
                           style="-fx-text-fill: #1f2937; -fx-font-size: 14px; -fx-font-weight: 500; -fx-opacity: 0; -fx-max-width: 0;"/>
                </HBox>
                
                <HBox fx:id="navAdministration" alignment="CENTER_LEFT" spacing="15" onMouseClicked="#goBackToAdmin"
                      style="-fx-background-color: transparent; -fx-padding: 12 15; -fx-cursor: hand; -fx-background-radius: 12;">
                    <Label text="👤" style="-fx-text-fill: #1f2937; -fx-font-size: 22px; -fx-min-width: 24; -fx-min-height: 24; -fx-alignment: center;"/>
                    <Label fx:id="labelAdministration" text="Administration" 
                           style="-fx-text-fill: #1f2937; -fx-font-size: 14px; -fx-font-weight: 500; -fx-opacity: 0; -fx-max-width: 0;"/>
                </HBox>
                
                <Region VBox.vgrow="ALWAYS"/>
                
                <HBox fx:id="navParametres" alignment="CENTER_LEFT" spacing="15" 
                      style="-fx-background-color: transparent; -fx-padding: 12 15; -fx-cursor: hand; -fx-background-radius: 12;">
                    <Label text="⚙️" style="-fx-text-fill: #6b7280; -fx-font-size: 22px; -fx-min-width: 24; -fx-min-height: 24; -fx-alignment: center;"/>
                    <Label fx:id="labelParametres" text="Paramètres" 
                           style="-fx-text-fill: #6b7280; -fx-font-size: 14px; -fx-font-weight: 500; -fx-opacity: 0; -fx-max-width: 0;"/>
                </HBox>
                
                <HBox fx:id="navDeconnexion" alignment="CENTER_LEFT" spacing="15" 
                      style="-fx-background-color: transparent; -fx-padding: 12 15; -fx-cursor: hand; -fx-background-radius: 12;">
                    <Label text="⎋" style="-fx-text-fill: #ef4444; -fx-font-size: 22px; -fx-min-width: 24; -fx-min-height: 24; -fx-alignment: center;"/>
                    <Label fx:id="labelDeconnexion" text="Déconnexion" 
                           style="-fx-text-fill: #ef4444; -fx-font-size: 14px; -fx-font-weight: 500; -fx-opacity: 0; -fx-max-width: 0;"/>
                </HBox>
            </VBox>
            
            <!-- Support Section -->
            <VBox fx:id="supportSection" alignment="CENTER" spacing="10" 
                  style="-fx-padding: 15; -fx-opacity: 0; -fx-max-height: 0; -fx-background-color: #f9fafb; -fx-background-radius: 12;">
                <Label text="Besoin d'aide ?" 
                       style="-fx-text-fill: #1f2937; -fx-font-size: 13px; -fx-font-weight: 600;"/>
                <Label text="N'hésitez pas" 
                       style="-fx-text-fill: #6b7280; -fx-font-size: 11px; -fx-text-alignment: center;"/>
                <Label text="à nous contacter." 
                       style="-fx-text-fill: #6b7280; -fx-font-size: 11px; -fx-text-alignment: center;"/>
                <Button text="Support" 
                        style="-fx-background-color: #6366f1; -fx-text-fill: white; -fx-font-size: 11px; -fx-padding: 6 16; -fx-background-radius: 8; -fx-cursor: hand;"/>
            </VBox>
        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <VBox>
            <!-- TOP HEADER BAR -->
            <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="25.0"
                  style="-fx-background-color: white; -fx-padding: 18 35 18 35; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 2);">

                <!-- Search Bar -->
                <TextField fx:id="searchField" promptText="🔍 Rechercher une offre..." styleClass="search-bar" prefWidth="450.0"
                          style="-fx-background-color: #f8fafc; -fx-background-radius: 12; -fx-border-color: transparent; -fx-padding: 12 18; -fx-font-size: 14px; -fx-prompt-text-fill: #94a3b8;"/>

                <!-- Spacer -->
                <Region HBox.hgrow="ALWAYS"/>

                <!-- User Profile -->
                <HBox spacing="12.0" alignment="CENTER" style="-fx-background-color: #f8fafc; -fx-background-radius: 12; -fx-padding: 8 16;">
                    <StackPane fx:id="userAvatarContainer" style="-fx-background-color: linear-gradient(to bottom right, #667eea, #764ba2); -fx-background-radius: 20; -fx-pref-width: 40; -fx-pref-height: 40;">
                        <Label fx:id="userAvatarLabel" text="A" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    </StackPane>
                    <VBox alignment="CENTER_LEFT" spacing="1.0">
                        <Label fx:id="userNameLabel" text="Admin User" style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #1e293b;"/>
                        <Label fx:id="userRoleLabel" text="Administrateur" style="-fx-font-size: 11px; -fx-text-fill: #64748b;"/>
                    </VBox>
                </HBox>
            </HBox>

            <!-- CONTENT AREA WITH MODERN CARDS -->
            <VBox style="-fx-background-color: #f8fafc; -fx-padding: 30;" VBox.vgrow="ALWAYS">
                
                <TabPane VBox.vgrow="ALWAYS" styleClass="modern-tabpane" style="-fx-background-color: white; -fx-border-color: transparent;">
                    <tabs>
                        <!-- OFFRES TAB -->
                        <Tab text="Gestion des Offres" closable="false" styleClass="modern-tab">
                            <VBox spacing="0" style="-fx-padding: 0; -fx-background-color: #f8fafc;">

                                <!-- Page Header -->
                                <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 30 40; -fx-background-color: #f8fafc;">
                                    <HBox alignment="CENTER_LEFT" spacing="15" HBox.hgrow="ALWAYS">
                                        <Label text="💼" style="-fx-font-size: 32px;"/>
                                        <VBox spacing="2">
                                            <Label text="Gestion des Offres" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                                            <Label text="Gérez vos offres d'emploi" style="-fx-font-size: 13px; -fx-text-fill: #64748b;"/>
                                        </VBox>
                                    </HBox>
                                    <Button text="+ Nouvelle Offre" onAction="#ajouterOffre"
                                            style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: 600; -fx-padding: 12 28; -fx-background-radius: 8; -fx-cursor: hand;"/>
                                </HBox>

                                <!-- Table Card -->
                                <VBox style="-fx-background-color: white; -fx-padding: 30 40; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                                    <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-padding: 0 0 20 0;">
                                        <Button text="🔄 Actualiser" onAction="#rafraichirOffres"
                                                style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-font-size: 13px; -fx-font-weight: 600; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                    </HBox>
                                    <TableView fx:id="offreTable" styleClass="modern-table" VBox.vgrow="ALWAYS"
                                              style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 0;">
                                        <columns>
                                            <TableColumn fx:id="colIdOffre" text="#" prefWidth="60"/>
                                            <TableColumn fx:id="colTitre" text="Titre du Poste" prefWidth="240"/>
                                            <TableColumn fx:id="colDescription" text="Description" prefWidth="280"/>
                                            <TableColumn fx:id="colTypeContrat" text="Type Contrat" prefWidth="140"/>
                                            <TableColumn fx:id="colWorkPreference" text="Mode de Travail" prefWidth="140"/>
                                            <TableColumn fx:id="colLieu" text="Lieu" prefWidth="150"/>
                                            <TableColumn fx:id="colStatutOffre" text="Statut" prefWidth="130"/>
                                            <TableColumn fx:id="colDatePublication" text="Date Publication" prefWidth="150"/>
                                            <TableColumn fx:id="colIdUtilisateur" text="Créé par" prefWidth="100"/>
                                            <TableColumn fx:id="colActions" text="Actions" prefWidth="140"/>
                                        </columns>
                                    </TableView>
                                </VBox>
                            </VBox>
                        </Tab>

                        <!-- CRITERE TAB -->
                        <Tab text="Gestion des Critères" closable="false" styleClass="modern-tab">
                            <VBox spacing="0" style="-fx-padding: 0; -fx-background-color: #f8fafc;">

                                <!-- Page Header -->
                                <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 30 40; -fx-background-color: #f8fafc;">
                                    <HBox alignment="CENTER_LEFT" spacing="15" HBox.hgrow="ALWAYS">
                                        <Label text="🎯" style="-fx-font-size: 32px;"/>
                                        <VBox spacing="2">
                                            <Label text="Gestion des Critères" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                                            <Label text="Gérez vos critères de sélection" style="-fx-font-size: 13px; -fx-text-fill: #64748b;"/>
                                        </VBox>
                                    </HBox>
                                    <Button text="+ Nouveau Critère" onAction="#ajouterCritere"
                                            style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: 600; -fx-padding: 12 28; -fx-background-radius: 8; -fx-cursor: hand;"/>
                                </HBox>

                                <!-- Table Card -->
                                <VBox style="-fx-background-color: white; -fx-padding: 30 40; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                                    <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-padding: 0 0 20 0;">
                                        <Button text="🔄 Actualiser" onAction="#rafraichirCriteres"
                                                style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-font-size: 13px; -fx-font-weight: 600; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
                                    </HBox>
                                    <TableView fx:id="critereTable" styleClass="modern-table" VBox.vgrow="ALWAYS"
                                              style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 0;">
                                        <columns>
                                            <TableColumn fx:id="colIdCritere" text="#" prefWidth="60"/>
                                            <TableColumn fx:id="colNiveauExperience" text="Niveau d'Expérience" prefWidth="200"/>
                                            <TableColumn fx:id="colNiveauEtude" text="Niveau d'Étude" prefWidth="180"/>
                                            <TableColumn fx:id="colResponsibilities" text="Responsabilités" prefWidth="280"/>
                                            <TableColumn fx:id="colCompetences" text="Compétences Requises" prefWidth="280"/>
                                            <TableColumn fx:id="colIdOffreCritere" text="Offre Associée" prefWidth="140"/>
                                            <TableColumn fx:id="colCritereActions" text="Actions" prefWidth="140"/>
                                        </columns>
                                    </TableView>
                                </VBox>
                            </VBox>
                        </Tab>

                        <!-- STATISTICS TAB -->
                        <Tab text="📊 Statistiques" closable="false" styleClass="modern-tab">
                            <VBox fx:id="statisticsContainer" spacing="0" style="-fx-padding: 0; -fx-background-color: #f8fafc;">
                                
                                <!-- Page Header -->
                                <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 30 40; -fx-background-color: #f8fafc;">
                                    <HBox alignment="CENTER_LEFT" spacing="15" HBox.hgrow="ALWAYS">
                                        <Label text="📈" style="-fx-font-size: 32px;"/>
                                        <VBox spacing="2">
                                            <Label text="Statistiques" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                                            <Label text="Analysez vos données" style="-fx-font-size: 13px; -fx-text-fill: #64748b;"/>
                                        </VBox>
                                    </HBox>
                                    <Button text="🔄 Actualiser" onAction="#refreshStatistics"
                                            style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: 600; -fx-padding: 12 28; -fx-background-radius: 8; -fx-cursor: hand;"/>
                                </HBox>

                                <!-- Statistics Cards -->
                                <HBox fx:id="statsCardsContainer" spacing="20" style="-fx-padding: 0 40 30 40; -fx-background-color: #f8fafc;">
                                    <!-- Cards will be added dynamically -->
                                </HBox>

                                <!-- Charts Section -->
                                <VBox spacing="30" style="-fx-padding: 0 40 30 40; -fx-background-color: #f8fafc;" VBox.vgrow="ALWAYS">
                                    
                                    <!-- First row: Pie Charts -->
                                    <HBox spacing="20">
                                        <!-- Status Distribution Chart -->
                                        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);" HBox.hgrow="ALWAYS">
                                            <Label text="Offres par Statut" style="-fx-font-size: 18px; -fx-font-weight: 700; -fx-text-fill: #1e293b;"/>
                                            <PieChart fx:id="statusPieChart" VBox.vgrow="ALWAYS" legendVisible="true" 
                                                                          style="-fx-background-color: white;"/>
                                        </VBox>

                                        <!-- Contract Type Distribution Chart -->
                                        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);" HBox.hgrow="ALWAYS">
                                            <Label text="Offres par Type de Contrat" style="-fx-font-size: 18px; -fx-font-weight: 700; -fx-text-fill: #1e293b;"/>
                                            <PieChart fx:id="contractTypePieChart" VBox.vgrow="ALWAYS" legendVisible="true"
                                                                          style="-fx-background-color: white;"/>
                                        </VBox>
                                    </HBox>

                                    <!-- Second row: Additional Charts -->
                                    <HBox spacing="20">
                                        <!-- Work Preference Distribution -->
                                        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);" HBox.hgrow="ALWAYS">
                                            <Label text="Préférences de Travail" style="-fx-font-size: 18px; -fx-font-weight: 700; -fx-text-fill: #1e293b;"/>
                                            <PieChart fx:id="workPrefPieChart" VBox.vgrow="ALWAYS" legendVisible="true"
                                                                          style="-fx-background-color: white;"/>
                                        </VBox>

                                        <!-- Top Locations -->
                                        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);" HBox.hgrow="ALWAYS">
                                            <Label text="Top 5 Localisations" style="-fx-font-size: 18px; -fx-font-weight: 700; -fx-text-fill: #1e293b;"/>
                                            <BarChart fx:id="locationBarChart" VBox.vgrow="ALWAYS" legendVisible="false"
                                                                          style="-fx-background-color: white;">
                                                <xAxis>
                                                    <CategoryAxis side="BOTTOM" label="Lieu"/>
                                                </xAxis>
                                                <yAxis>
                                                    <NumberAxis side="LEFT" label="Nombre"/>
                                                </yAxis>
                                            </BarChart>
                                        </VBox>
                                    </HBox>

                                </VBox>
                            </VBox>
                        </Tab>

                    </tabs>
                </TabPane>
            </VBox>
        </VBox>
    </center>
</BorderPane>
