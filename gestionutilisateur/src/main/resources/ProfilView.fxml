<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.*?>

<BorderPane prefHeight="1024.0" prefWidth="1440.0" stylesheets="@modernuser.css" 
            xmlns="http://javafx.com/javafx/17" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="controllers.ProfilController">

    <!-- SIDEBAR NORMAL -->
    <left>
        <VBox styleClass="sidebar" prefWidth="80.0">
            <VBox alignment="CENTER" styleClass="logo-container">
                <Label text="VOS" styleClass="logo-text"/>
            </VBox>

            <VBox alignment="TOP_CENTER" spacing="20.0" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets top="30.0"/>
                </padding>
                <Button styleClass="nav-icon" text="🏠"/>
                <Button styleClass="nav-icon" text="📋"/>
                <Button styleClass="nav-icon" text="💼"/>
                <Button styleClass="nav-icon" text="⭐"/>
                <Button styleClass="nav-icon" text="⚙️"/>
                <Button styleClass="nav-icon" text="➡️" onAction="#retournerOffres"/>
            </VBox>
        </VBox>
    </left>

    <!-- CONTENU PRINCIPAL -->
    <center>
        <VBox style="-fx-background-color: #F5F7FA;">
            
            <!-- HEADER -->
            <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="20.0">
                <padding>
                    <Insets top="20.0" right="30.0" bottom="20.0" left="30.0"/>
                </padding>

                <VBox spacing="5">
                    <Label text="Mon Profil" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1F2937;"/>
                    <Label text="Gérez vos informations personnelles" style="-fx-font-size: 13px; -fx-text-fill: #6B7280;"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="⬅️ Retour" onAction="#retournerOffres" style="-fx-background-color: #6366F1; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand; -fx-border-width: 0;"/>
            </HBox>

            <!-- CONTENU SCROLLABLE -->
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-border-width: 0;">
                <VBox spacing="25" style="-fx-padding: 30;">
                    
                    <!-- CARTE PROFIL PRINCIPALE -->
                    <VBox spacing="0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 2);">
                        
                        <!-- BANNIERE SUPERIEURE -->
                        <VBox style="-fx-background-color: #6366F1; -fx-background-radius: 15 15 0 0; -fx-min-height: 120; -fx-padding: 30;">
                            <Label text="👤 Informations du compte" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                        </VBox>

                        <!-- SECTION AVATAR ET INFO -->
                        <VBox spacing="40" style="-fx-padding: 0 40 40 40;">
                            
                            <!-- AVATAR AVEC BOUTON -->
                            <VBox alignment="CENTER" spacing="20" style="-fx-translate-y: -50;">
                                <StackPane>
                                    <!-- Cercle fond blanc -->
                                    <Circle radius="85" style="-fx-fill: white; -fx-stroke: #FFD700; -fx-stroke-width: 5; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 15, 0, 0, 4);"/>
                                    
                                    <!-- Image -->
                                    <StackPane style="-fx-min-width: 160; -fx-min-height: 160;">
                                        <Circle radius="78" style="-fx-fill: #E5E7EB;"/>
                                        <ImageView fx:id="imgProfil" fitWidth="156" fitHeight="156" preserveRatio="true">
                                            <clip>
                                                <Circle radius="78" centerX="78" centerY="78"/>
                                            </clip>
                                        </ImageView>
                                    </StackPane>
                                </StackPane>
                                
                                <Button text="📷 Changer la photo de profil" onAction="#uploadImage" 
                                       style="-fx-background-color: #6366F1; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 600; -fx-padding: 10 24; -fx-background-radius: 8; -fx-cursor: hand; -fx-border-width: 0; -fx-effect: dropshadow(gaussian, rgba(99,102,241,0.3), 8, 0, 0, 2);"/>
                            </VBox>

                            <!-- INFORMATIONS DÉTAILLÉES DU CLIENT -->
                            <VBox spacing="30" HBox.hgrow="ALWAYS">
                                
                                <!-- Nom complet -->
                                <VBox spacing="8" alignment="CENTER">
                                    <Label text="👤 Identité" style="-fx-font-size: 13px; -fx-text-fill: #9CA3AF; -fx-font-weight: 600;"/>
                                    <Label fx:id="lblNom" text="Nom Prénom" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                                </VBox>

                                <!-- Grille d'informations -->
                                <GridPane hgap="30" vgap="25" style="-fx-padding: 20; -fx-background-color: #F9FAFB; -fx-background-radius: 12;">
                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="50"/>
                                        <ColumnConstraints percentWidth="50"/>
                                    </columnConstraints>

                                    <!-- Email -->
                                    <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                        <HBox spacing="8" alignment="CENTER_LEFT">
                                            <Label text="📧" style="-fx-font-size: 18px;"/>
                                            <Label text="Adresse Email" style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #6B7280;"/>
                                        </HBox>
                                        <Label fx:id="lblEmail" text="email@example.com" style="-fx-font-size: 16px; -fx-text-fill: #111827; -fx-font-weight: 600; -fx-padding: 0 0 0 26;"/>
                                    </VBox>

                                    <!-- Role -->
                                    <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                        <HBox spacing="8" alignment="CENTER_LEFT">
                                            <Label text="🏷️" style="-fx-font-size: 18px;"/>
                                            <Label text="Type de compte" style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #6B7280;"/>
                                        </HBox>
                                        <HBox spacing="10" style="-fx-padding: 0 0 0 26;">
                                            <Label fx:id="lblRole" text="CLIENT" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #059669; -fx-background-color: #D1FAE5; -fx-padding: 6 16; -fx-background-radius: 8;"/>
                                        </HBox>
                                    </VBox>

                                    <!-- ID utilisateur -->
                                    <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                        <HBox spacing="8" alignment="CENTER_LEFT">
                                            <Label text="🆔" style="-fx-font-size: 18px;"/>
                                            <Label text="Identifiant" style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #6B7280;"/>
                                        </HBox>
                                        <Label fx:id="lblIdUtilisateur" text="#0000" style="-fx-font-size: 16px; -fx-text-fill: #111827; -fx-font-weight: 600; -fx-padding: 0 0 0 26;"/>
                                    </VBox>

                                    <!-- Statistiques -->
                                    <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                        <HBox spacing="8" alignment="CENTER_LEFT">
                                            <Label text="📊" style="-fx-font-size: 18px;"/>
                                            <Label text="Candidatures envoyées" style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #6B7280;"/>
                                        </HBox>
                                        <Label fx:id="lblStatCandidatures" text="0 candidature" style="-fx-font-size: 16px; -fx-text-fill: #6366F1; -fx-font-weight: 600; -fx-padding: 0 0 0 26;"/>
                                    </VBox>

                                </GridPane>

                                <!-- Boutons d'action -->
                                <HBox spacing="15" alignment="CENTER" style="-fx-padding: 20 0 0 0;">
                                    <Button text="✏️ Modifier mon profil" fx:id="btnModifier" onAction="#activerEdition" 
                                           style="-fx-background-color: #6366F1; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-padding: 14 35; -fx-background-radius: 8; -fx-cursor: hand; -fx-border-width: 0; -fx-effect: dropshadow(gaussian, rgba(99,102,241,0.3), 12, 0, 0, 4);"/>
                                    <Button text="🗑️ Supprimer mon compte" onAction="#supprimerCompte" 
                                           style="-fx-background-color: #FEE2E2; -fx-text-fill: #DC2626; -fx-font-size: 15px; -fx-font-weight: 600; -fx-padding: 14 35; -fx-background-radius: 8; -fx-cursor: hand; -fx-border-color: #FCA5A5; -fx-border-width: 2; -fx-border-radius: 8;"/>
                                </HBox>

                            </VBox>

                        </VBox>

                    </VBox>

                    <!-- FORMULAIRE D'EDITION (masqué par défaut) -->
                    <VBox fx:id="formContainer" managed="false" visible="false" spacing="0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 2);">
                        
                        <!-- Header formulaire -->
                        <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: #F9FAFB; -fx-background-radius: 15 15 0 0; -fx-padding: 25;">
                            <Label text="✏️" style="-fx-font-size: 28px;"/>
                            <Label text="Modifier mes informations" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                        </HBox>

                        <!-- Contenu formulaire -->
                        <VBox spacing="25" style="-fx-padding: 30;">
                            
                            <!-- Grille des champs -->
                            <GridPane hgap="20" vgap="20">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="50"/>
                                    <ColumnConstraints percentWidth="50"/>
                                </columnConstraints>

                                <!-- Nom -->
                                <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <Label text="Nom *" style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #374151;"/>
                                    <TextField fx:id="tfNom" promptText="Votre nom (lettres uniquement)" style="-fx-font-size: 14px; -fx-padding: 12; -fx-background-color: #F9FAFB; -fx-border-color: #E5E7EB; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8;"/>
                                    <Label text="Min. 2 caractères, lettres uniquement" style="-fx-font-size: 11px; -fx-text-fill: #9CA3AF;"/>
                                </VBox>

                                <!-- Prénom -->
                                <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <Label text="Prénom *" style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #374151;"/>
                                    <TextField fx:id="tfPrenom" promptText="Votre prénom (lettres uniquement)" style="-fx-font-size: 14px; -fx-padding: 12; -fx-background-color: #F9FAFB; -fx-border-color: #E5E7EB; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8;"/>
                                    <Label text="Min. 2 caractères, lettres uniquement" style="-fx-font-size: 11px; -fx-text-fill: #9CA3AF;"/>
                                </VBox>

                                <!-- Email -->
                                <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2">
                                    <Label text="Adresse Email *" style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #374151;"/>
                                    <TextField fx:id="tfEmail" promptText="votre.email@exemple.com" style="-fx-font-size: 14px; -fx-padding: 12; -fx-background-color: #F9FAFB; -fx-border-color: #E5E7EB; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8;"/>
                                    <Label text="Format: utilisateur@domaine.com" style="-fx-font-size: 11px; -fx-text-fill: #9CA3AF;"/>
                                </VBox>

                                <!-- Mot de passe -->
                                <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="2">
                                    <Label text="Mot de passe *" style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #374151;"/>
                                    <PasswordField fx:id="tfMotDePasse" promptText="••••••••" style="-fx-font-size: 14px; -fx-padding: 12; -fx-background-color: #F9FAFB; -fx-border-color: #E5E7EB; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8;"/>
                                    <Label text="Min. 6 caractères" style="-fx-font-size: 11px; -fx-text-fill: #9CA3AF;"/>
                                </VBox>
                            </GridPane>

                            <!-- Note champs obligatoires -->
                            <HBox spacing="8" alignment="CENTER_LEFT" style="-fx-padding: 0 0 10 0;">
                                <Label text="*" style="-fx-font-size: 14px; -fx-text-fill: #DC2626; -fx-font-weight: bold;"/>
                                <Label text="Champs obligatoires" style="-fx-font-size: 13px; -fx-text-fill: #6B7280;"/>
                            </HBox>

                            <!-- Message statut -->
                            <Label fx:id="lblStatus" visible="false" managed="false" style="-fx-font-size: 14px; -fx-padding: 12 16; -fx-background-color: #D1FAE5; -fx-text-fill: #059669; -fx-font-weight: 600; -fx-background-radius: 8;"/>

                            <!-- Boutons -->
                            <HBox spacing="15" alignment="CENTER">
                                <Button text="💾 Enregistrer les modifications" onAction="#sauvegarderModifications" 
                                       style="-fx-background-color: #6366F1; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-padding: 14 35; -fx-background-radius: 8; -fx-cursor: hand; -fx-border-width: 0; -fx-effect: dropshadow(gaussian, rgba(99,102,241,0.3), 10, 0, 0, 3);"/>
                                <Button text="❌ Annuler" onAction="#annulerEdition" 
                                       style="-fx-background-color: #F3F4F6; -fx-text-fill: #6B7280; -fx-font-size: 15px; -fx-font-weight: 600; -fx-padding: 14 30; -fx-background-radius: 8; -fx-cursor: hand; -fx-border-width: 0;"/>
                            </HBox>

                        </VBox>

                    </VBox>

                </VBox>
            </ScrollPane>

        </VBox>
    </center>

</BorderPane>
