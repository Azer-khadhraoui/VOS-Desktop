<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.ForgotPasswordController"
            stylesheets="@styleUser.css"
            prefWidth="1440"
            prefHeight="1024">

    <!-- BACKGROUND -->
    <Pane prefWidth="1440"
          prefHeight="1024"
          style="-fx-background-color: #F3F4F6; -fx-background-image: url('/img/mdpconfirmbackG.png'); -fx-background-repeat: no-repeat; -fx-background-position: center center; -fx-background-size: 1296px 752px;"/>

    <!-- FORMULAIRE -->
    <VBox prefWidth="360"
          layoutX="800"
          layoutY="160"
          spacing="10"
          alignment="TOP_LEFT"
          style="-fx-background-color: transparent;">

        <Label text="Nouveau mot de passe" styleClass="title"/>
        <Label text="Créez un mot de passe sécurisé"
               styleClass="subtitle"/>

        <!-- NOUVEAU MOT DE PASSE -->
        <Label text="Nouveau mot de passe" styleClass="fieldLabel"/>
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="inputBox">
            <Label text="🔒"/>
            <PasswordField fx:id="tfNewPassword"
                           promptText="••••••••"
                           styleClass="inputField"/>
        </HBox>

        <!-- CONFIRMER MOT DE PASSE -->
        <Label text="Confirmer le mot de passe" styleClass="fieldLabel"/>
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="inputBox">
            <Label text="🔒"/>
            <PasswordField fx:id="tfConfirmPassword"
                           promptText="••••••••"
                           styleClass="inputField"/>
        </HBox>

        <!-- BOUTON RÉINITIALISER -->
        <HBox alignment="CENTER" style="-fx-padding: 8 0 0 0;">
            <Button text="✓ Réinitialiser"
                    onAction="#resetPassword"
                    styleClass="btnSignupGlow"/>
        </HBox>

        <!-- MESSAGE -->
        <Label fx:id="lblResetMessage" styleClass="message"/>

        <!-- LIEN RETOUR LOGIN -->
        <HBox spacing="6" alignment="CENTER_LEFT" styleClass="hintRow" style="-fx-padding: 12 0 0 0;">
            <Hyperlink text="← Retour à la connexion"
                       onAction="#goToSignin"
                       styleClass="link"/>
        </HBox>

    </VBox>

</AnchorPane>
