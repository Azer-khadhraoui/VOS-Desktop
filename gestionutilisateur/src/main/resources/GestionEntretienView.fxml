<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.*?>
<?import javafx.scene.chart.PieChart?>

<StackPane prefHeight="1024.0" prefWidth="1440.0"
           minHeight="1024.0" minWidth="1440.0"
           maxHeight="1024.0" maxWidth="1440.0" 
           xmlns="http://javafx.com/javafx/17" 
           xmlns:fx="http://javafx.com/fxml/1" 
           fx:controller="controllers.GestionEntretienController">

<BorderPane fx:id="rootBorder" prefHeight="1024.0" prefWidth="1440.0" stylesheets="@AdministrationView.css,@styles/entretien-modern.css">

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox fx:id="sidebar" styleClass="sidebar" prefWidth="80.0">
            <!-- Logo -->
            <VBox alignment="CENTER" styleClass="sidebar-logo">
                <ImageView fitHeight="55" fitWidth="55" preserveRatio="true">
                    <Image url="@img/VOSwhiteslogan.png"/>
                </ImageView>
            </VBox>

            <!-- Navigation Icons -->
            <VBox fx:id="navContainer" alignment="TOP_CENTER" spacing="20.0" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets top="30.0"/>
                </padding>

                <HBox fx:id="btnStatistiques" styleClass="sidebar-nav-item" alignment="CENTER_LEFT" spacing="15.0" onMouseClicked="#goToStatistiques">
                    <Label text="📊" styleClass="sidebar-nav-icon"/>
                    <Label text="Statistiques" styleClass="sidebar-nav-label"/>
                </HBox>
                <HBox fx:id="btnUtilisateurs" styleClass="sidebar-nav-item" alignment="CENTER_LEFT" spacing="15.0" onMouseClicked="#goToAdministration">
                    <Label text="👥" styleClass="sidebar-nav-icon"/>
                    <Label text="Utilisateurs" styleClass="sidebar-nav-label"/>
                </HBox>
                <HBox fx:id="btnOffres" styleClass="sidebar-nav-item" alignment="CENTER_LEFT" spacing="15.0" onMouseClicked="#goToOffres">
                    <Label text="💼" styleClass="sidebar-nav-icon"/>
                    <Label text="Offres" styleClass="sidebar-nav-label"/>
                </HBox>
                <HBox fx:id="btnServices" styleClass="sidebar-nav-item" alignment="CENTER_LEFT" spacing="15.0" onMouseClicked="#goToServices">
                    <Label text="🛠️" styleClass="sidebar-nav-icon"/>
                    <Label text="Services" styleClass="sidebar-nav-label"/>
                </HBox>
                <HBox fx:id="btnEntretiens" styleClass="sidebar-nav-item,sidebar-nav-item-active" alignment="CENTER_LEFT" spacing="15.0">
                    <Label text="📋" styleClass="sidebar-nav-icon"/>
                    <Label text="Entretiens" styleClass="sidebar-nav-label"/>
                </HBox>
                <HBox styleClass="sidebar-nav-item" alignment="CENTER_LEFT" spacing="15.0">
                    <Label text="⚙️" styleClass="sidebar-nav-icon"/>
                    <Label text="Paramètres" styleClass="sidebar-nav-label"/>
                </HBox>
                <HBox fx:id="logoutBtn" styleClass="sidebar-nav-item,sidebar-nav-logout" alignment="CENTER_LEFT" spacing="15.0" onMouseClicked="#logout">
                    <Label text="➡️" styleClass="sidebar-nav-icon"/>
                    <Label text="Déconnexion" styleClass="sidebar-nav-label"/>
                </HBox>
            </VBox>
        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <VBox style="-fx-background-color: #f8f9fa;">
            <!-- TOP HEADER BAR -->
            <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="20.0">
                <padding>
                    <Insets top="20.0" right="30.0" bottom="20.0" left="30.0"/>
                </padding>

                <!-- Search Bar -->
                <TextField fx:id="searchField" promptText="🔍 Rechercher..." styleClass="search-bar" prefWidth="400.0"/>

                <!-- Spacer -->
                <Region HBox.hgrow="ALWAYS"/>

                <!-- User Profile -->
                <HBox spacing="15.0" alignment="CENTER">
                    <StackPane fx:id="userAvatarContainer" styleClass="user-avatar-container">
                        <Label fx:id="lblUserAvatar" text="👤" styleClass="user-avatar"/>
                    </StackPane>
                    <VBox alignment="CENTER_LEFT" spacing="2.0">
                        <Label fx:id="lblUserName" text="Admin" styleClass="user-name"/>
                        <Label fx:id="lblUserRole" text="ADMIN" styleClass="user-role"/>
                    </VBox>
                </HBox>
            </HBox>

            <!-- CONTENT AREA with StackPane for page switching -->
            <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: #f8f9fa; -fx-border-color: transparent;">
                <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS">

                    <!-- PAGE: ENTRETIENS & EVALUATIONS -->
                    <VBox fx:id="pageEntretiens" visible="true" managed="true">
                        <TabPane fx:id="mainTabPane" styleClass="modern-tabs" VBox.vgrow="ALWAYS">
                            <tabs>
                                <!-- Entretiens Tab -->
                                <Tab fx:id="tabEntretiens" text="Gestion des Entretiens" closable="false">
                                    <VBox spacing="0" style="-fx-padding: 0; -fx-background-color: #f8fafc;">
                                        <!-- Page Header -->
                                        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 30 40; -fx-background-color: #f8fafc;">
                                            <HBox alignment="CENTER_LEFT" spacing="15" HBox.hgrow="ALWAYS">
                                                <Label text="📋" style="-fx-font-size: 32px;"/>
                                                <VBox spacing="2">
                                                    <Label text="Gestion des Entretiens" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                                                    <Label text="Gérez vos entretiens" style="-fx-font-size: 13px; -fx-text-fill: #64748b;"/>
                                                </VBox>
                                            </HBox>
                                            <Button text="+ Nouvel Entretien" onAction="#ajouterEntretien"
                                                    style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: 600; -fx-padding: 12 28; -fx-background-radius: 8; -fx-cursor: hand;"/>
                                        </HBox>

                                        <!-- Table Card -->
                                        <VBox style="-fx-background-color: white; -fx-padding: 30 40; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                                            <TableView fx:id="tableEntretiens" styleClass="modern-table" VBox.vgrow="ALWAYS"
                                                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 0;">
                                                <columns>
                                                    <TableColumn fx:id="colIdEntretien" text="ID" prefWidth="60.0"/>
                                                    <TableColumn fx:id="colDateEntretien" text="Date" prefWidth="110.0"/>
                                                    <TableColumn fx:id="colHeureEntretien" text="Heure" prefWidth="90.0"/>
                                                    <TableColumn fx:id="colTypeEntretien" text="Type" prefWidth="110.0"/>
                                                    <TableColumn fx:id="colStatutEntretien" text="Statut" prefWidth="110.0"/>
                                                    <TableColumn fx:id="colLieuEntretien" text="Lieu" prefWidth="200.0"/>
                                                    <TableColumn fx:id="colTypeTest" text="Type Test" prefWidth="180.0"/>
                                                    <TableColumn fx:id="colActions" text="Actions" prefWidth="250.0"/>
                                                </columns>
                                            </TableView>
                                        </VBox>
                                    </VBox>
                                </Tab>

                                <!-- Evaluations Tab -->
                                <Tab fx:id="tabEvaluations" text="Gestion des Évaluations" closable="false">
                                    <VBox spacing="0" style="-fx-padding: 0; -fx-background-color: #f8fafc;">
                                        <!-- Page Header -->
                                        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 30 40; -fx-background-color: #f8fafc;">
                                            <HBox alignment="CENTER_LEFT" spacing="15" HBox.hgrow="ALWAYS">
                                                <Label text="⭐" style="-fx-font-size: 32px;"/>
                                                <VBox spacing="2">
                                                    <Label text="Gestion des Évaluations" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                                                    <Label text="Gérez vos évaluations" style="-fx-font-size: 13px; -fx-text-fill: #64748b;"/>
                                                </VBox>
                                            </HBox>
                                            <Button text="+ Nouvelle Évaluation" onAction="#ajouterEvaluation"
                                                    style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: 600; -fx-padding: 12 28; -fx-background-radius: 8; -fx-cursor: hand;"/>
                                        </HBox>

                                        <!-- Table Card -->
                                        <VBox style="-fx-background-color: white; -fx-padding: 30 40; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                                            <TableView fx:id="tableEvaluations" styleClass="modern-table" VBox.vgrow="ALWAYS"
                                                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 0;">
                                                <columns>
                                                    <TableColumn fx:id="colIdEvaluation" text="ID" prefWidth="60.0"/>
                                                    <TableColumn fx:id="colScoreTest" text="Score" prefWidth="100.0"/>
                                                    <TableColumn fx:id="colNoteEntretien" text="Note" prefWidth="100.0"/>
                                                    <TableColumn fx:id="colCommentaire" text="Commentaire" prefWidth="300.0"/>
                                                    <TableColumn fx:id="colDecision" text="Décision" prefWidth="120.0"/>
                                                    <TableColumn fx:id="colIdEntretienEval" text="ID Entretien" prefWidth="120.0"/>
                                                    <TableColumn fx:id="colActionsEval" text="Actions" prefWidth="200.0"/>
                                                </columns>
                                            </TableView>
                                        </VBox>
                                    </VBox>
                                </Tab>

                                <!-- Statistiques Tab -->
                                <Tab fx:id="tabStats" text="Statistiques des Entretiens" closable="false">
                                    <VBox fx:id="statsRoot" spacing="24.0">
                                        <padding>
                                            <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
                                        </padding>

                                        <HBox alignment="CENTER_LEFT" spacing="20.0">
                                            <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                                <Label text="📊 Statistiques" styleClass="page-title"/>
                                                <Label text="Analysez vos entretiens" styleClass="page-subtitle"/>
                                            </VBox>
                                            <Button fx:id="btnRefreshStats" text="🔄 Actualiser" onAction="#rafraichirStats" styleClass="btn-add"/>
                                        </HBox>

                                        <HBox spacing="16.0">
                                            <VBox spacing="6.0" prefWidth="230.0"
                                                  style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 4);">
                                                <Label text="Total des Entretiens" style="-fx-text-fill: #6B7280; -fx-font-size: 12px;"/>
                                                <Label fx:id="lblStatTotalEntretiens" text="0" style="-fx-font-size: 26px; -fx-font-weight: bold;"/>
                                                <Label text="Toutes les campagnes" style="-fx-text-fill: #94A3B8; -fx-font-size: 11px;"/>
                                            </VBox>
                                            <VBox spacing="6.0" prefWidth="230.0"
                                                  style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 4);">
                                                <Label text="Entretiens Termines" style="-fx-text-fill: #6B7280; -fx-font-size: 12px;"/>
                                                <Label fx:id="lblStatTermines" text="0" style="-fx-font-size: 26px; -fx-font-weight: bold;"/>
                                                <Label text="Clotures" style="-fx-text-fill: #94A3B8; -fx-font-size: 11px;"/>
                                            </VBox>
                                            <VBox spacing="6.0" prefWidth="230.0"
                                                  style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 4);">
                                                <Label text="Entretiens Planifies" style="-fx-text-fill: #6B7280; -fx-font-size: 12px;"/>
                                                <Label fx:id="lblStatPlanifies" text="0" style="-fx-font-size: 26px; -fx-font-weight: bold;"/>
                                                <Label text="A venir" style="-fx-text-fill: #94A3B8; -fx-font-size: 11px;"/>
                                            </VBox>
                                            <VBox spacing="6.0" prefWidth="230.0"
                                                  style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 4);">
                                                <Label text="Total des Evaluations" style="-fx-text-fill: #6B7280; -fx-font-size: 12px;"/>
                                                <Label fx:id="lblStatTotalEvaluations" text="0" style="-fx-font-size: 26px; -fx-font-weight: bold;"/>
                                                <Label text="Rapports complets" style="-fx-text-fill: #94A3B8; -fx-font-size: 11px;"/>
                                            </VBox>
                                        </HBox>

                                        <HBox spacing="16.0">
                                            <VBox spacing="6.0" prefWidth="230.0"
                                                  style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 4);">
                                                <Label text="Score Moyen" style="-fx-text-fill: #6B7280; -fx-font-size: 12px;"/>
                                                <Label fx:id="lblStatAvgScore" text="0.0" style="-fx-font-size: 26px; -fx-font-weight: bold;"/>
                                                <Label text="Sur 100" style="-fx-text-fill: #94A3B8; -fx-font-size: 11px;"/>
                                            </VBox>
                                            <VBox spacing="6.0" prefWidth="230.0"
                                                  style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 4);">
                                                <Label text="Note Moyenne" style="-fx-text-fill: #6B7280; -fx-font-size: 12px;"/>
                                                <Label fx:id="lblStatAvgNote" text="0.0" style="-fx-font-size: 26px; -fx-font-weight: bold;"/>
                                                <Label text="Sur 5" style="-fx-text-fill: #94A3B8; -fx-font-size: 11px;"/>
                                            </VBox>
                                            <VBox spacing="6.0" prefWidth="230.0"
                                                  style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 4);">
                                                <Label text="Autres Statuts" style="-fx-text-fill: #6B7280; -fx-font-size: 12px;"/>
                                                <Label fx:id="lblStatAutres" text="0" style="-fx-font-size: 26px; -fx-font-weight: bold;"/>
                                                <Label text="Annules / En attente" style="-fx-text-fill: #94A3B8; -fx-font-size: 11px;"/>
                                            </VBox>
                                            <Region HBox.hgrow="ALWAYS"/>
                                        </HBox>

                                        <HBox spacing="20.0">
                                            <VBox spacing="12.0" HBox.hgrow="ALWAYS"
                                                  style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 4);">
                                                <Label text="Entretiens par Statut" style="-fx-font-size: 14px; -fx-font-weight: 700; -fx-text-fill: #111827;"/>
                                                <PieChart fx:id="chartStatut" prefHeight="260.0" legendVisible="true" labelsVisible="true"/>
                                            </VBox>
                                            <VBox spacing="12.0" HBox.hgrow="ALWAYS"
                                                  style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 4);">
                                                <Label text="Entretiens par Type" style="-fx-font-size: 14px; -fx-font-weight: 700; -fx-text-fill: #111827;"/>
                                                <PieChart fx:id="chartType" prefHeight="260.0" legendVisible="true" labelsVisible="true"/>
                                            </VBox>
                                        </HBox>
                                    </VBox>
                                </Tab>
                            </tabs>
                        </TabPane>
                    </VBox>

                    <!-- PAGE: DASHBOARD (Futur) -->
                    <VBox fx:id="pageDashboard" visible="false" managed="false" alignment="CENTER" style="-fx-background-color: white;">
                        <Label text="📊 Dashboard" style="-fx-font-size: 48px;"/>
                        <Label text="Statistiques à venir..." style="-fx-font-size: 18px; -fx-text-fill: gray;"/>
                    </VBox>

                    <!-- PAGE: STATISTIQUES (Futur) -->
                    <VBox fx:id="pageStats" visible="false" managed="false" alignment="CENTER" style="-fx-background-color: white;">
                        <Label text="📈 Statistiques" style="-fx-font-size: 48px;"/>
                        <Label text="Graphiques à venir..." style="-fx-font-size: 18px; -fx-text-fill: gray;"/>
                    </VBox>

                </StackPane>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>

</StackPane>
