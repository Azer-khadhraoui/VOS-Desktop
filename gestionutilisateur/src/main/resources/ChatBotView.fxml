<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.*?>

<BorderPane prefHeight="800.0" prefWidth="1000.0" 
            stylesheets="@AdministrationView.css"
            xmlns="http://javafx.com/javafx/17" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="controllers.ChatBotController">

    <!-- TOP HEADER -->
    <top>
        <VBox style="-fx-background-color: #667eea; -fx-padding: 20px;">
            <HBox spacing="15.0" alignment="CENTER_LEFT">
                <Label text="🤖" style="-fx-font-size: 28px;"/>
                <VBox spacing="2.0">
                    <Label text="Assistant RH IA VOS" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="Posez vos questions sur les congés, démission, opportunités..." 
                           style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.9);"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="✕" onAction="#closeChat" 
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 20px; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </top>

    <!-- MESSAGES AREA -->
    <center>
        <ScrollPane fx:id="messagesScroll" fitToWidth="true" 
                    style="-fx-background-color: #f5f7fa; -fx-border-color: transparent;">
            <VBox fx:id="messagesContainer" spacing="12.0" 
                  style="-fx-padding: 20px; -fx-background-color: #f5f7fa;">
            </VBox>
        </ScrollPane>
    </center>

    <!-- INPUT AREA -->
    <bottom>
        <VBox style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-width: 1 0 0 0; -fx-padding: 15px;">
            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <TextField fx:id="messageInput" 
                          promptText="Tapez votre question... (Ex: Comment demander des congés?)"
                          onKeyPressed="#handleKeyPress"
                          style="-fx-font-size: 13px; -fx-padding: 12px; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-radius: 8;"
                          HBox.hgrow="ALWAYS"/>
                <Button fx:id="sendBtn" text="Envoyer" onAction="#sendMessage"
                        style="-fx-background-color: #667eea; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 12px 30px; -fx-background-radius: 8; -fx-cursor: hand;"/>
            </HBox>
            <Label fx:id="statusLabel" text="" 
                   style="-fx-font-size: 11px; -fx-text-fill: #999; -fx-padding: 8 0 0 0;"/>
        </VBox>
    </bottom>

</BorderPane>
