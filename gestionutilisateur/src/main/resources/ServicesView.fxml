<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.geometry.Insets?>

<BorderPane prefHeight="1024.0" prefWidth="1440.0" stylesheets="@AdministrationView.css"
            xmlns="http://javafx.com/javafx/17" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="controllers.ServicesController">

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox styleClass="sidebar" prefWidth="80.0">
            <!-- Logo -->
            <VBox alignment="CENTER" styleClass="sidebar-logo">
                <ImageView fitWidth="55" fitHeight="55" preserveRatio="true">
                    <image>
                        <Image url="@img/VOSwhiteslogan.png"/>
                    </image>
                </ImageView>
            </VBox>

            <!-- Navigation Icons -->
            <VBox spacing="5" VBox.vgrow="ALWAYS">
                <HBox fx:id="navStatistiques" styleClass="sidebar-nav-item" alignment="CENTER" maxWidth="Infinity">
                    <Label text="📊" styleClass="sidebar-nav-icon"/>
                    <Label text="Statistiques" styleClass="sidebar-nav-label"/>
                </HBox>

                <HBox fx:id="navOpportunites" styleClass="sidebar-nav-item" alignment="CENTER" maxWidth="Infinity">
                    <Label text="💼" styleClass="sidebar-nav-icon"/>
                    <Label text="Opportunités" styleClass="sidebar-nav-label"/>
                </HBox>

                <HBox fx:id="navServices" styleClass="sidebar-nav-item sidebar-nav-item-active" alignment="CENTER" maxWidth="Infinity">
                    <Label text="🛠️" styleClass="sidebar-nav-icon"/>
                    <Label text="Services" styleClass="sidebar-nav-label"/>
                </HBox>

                <HBox fx:id="navAdministration" styleClass="sidebar-nav-item" alignment="CENTER" maxWidth="Infinity">
                    <Label text="👤" styleClass="sidebar-nav-icon"/>
                    <Label text="Administration" styleClass="sidebar-nav-label"/>
                </HBox>

                <Region VBox.vgrow="ALWAYS"/>

                <HBox fx:id="navDeconnexion" styleClass="sidebar-nav-logout" alignment="CENTER" maxWidth="Infinity">
                    <Label text="⎋" styleClass="sidebar-nav-icon"/>
                    <Label text="Déconnexion" styleClass="sidebar-nav-label"/>
                </HBox>
            </VBox>
        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <VBox>
            <!-- TOP HEADER BAR -->
            <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="20.0">
                <padding>
                    <Insets top="20.0" right="30.0" bottom="20.0" left="30.0"/>
                </padding>

                <!-- Spacer -->
                <Region HBox.hgrow="ALWAYS"/>

                <!-- User Profile -->
                <HBox spacing="15.0" alignment="CENTER">
                    <StackPane fx:id="userAvatarContainer" styleClass="user-avatar-container">
                        <Label fx:id="lblUserAvatar" text="👤" styleClass="user-avatar"/>
                    </StackPane>
                    <VBox alignment="CENTER_LEFT" spacing="2.0">
                        <Label fx:id="lblUserName" text="Mohamed Azer Khadhraoui" styleClass="user-name"/>
                        <Label fx:id="lblUserRole" text="CLIENT" styleClass="user-role"/>
                    </VBox>
                </HBox>
            </HBox>

            <!-- MAIN CONTENT AREA -->
            <VBox spacing="25.0" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
                </padding>

                <!-- Page Header -->
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <Label text="🛠️ SERVICES ET DEMANDES" styleClass="page-title" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
                </HBox>

                <!-- Services Grid -->
                <VBox spacing="20.0" VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER" spacing="40.0" VBox.vgrow="ALWAYS">

                        <!-- Demande de Congé Card -->
                        <VBox fx:id="cardCongé" spacing="15.0" 
                              style="-fx-border-radius: 15; -fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #667eea, #764ba2); -fx-padding: 30px; -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.2), 20, 0, 0, 10); -fx-cursor: hand;"
                              HBox.hgrow="ALWAYS">
                            <VBox alignment="CENTER" spacing="15.0">
                                <Label text="🏖️" style="-fx-font-size: 60px;"/>
                                <Label text="Demande de Congé" 
                                       style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                                <Label text="Demandez vos jours de congés" 
                                       style="-fx-font-size: 13px; -fx-text-fill: white; -fx-opacity: 0.9;"/>
                                <Button fx:id="btnCongé" text="➜ Accéder" 
                                        style="-fx-background-color: white; -fx-text-fill: #667eea; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 12px 30px; -fx-background-radius: 25; -fx-cursor: hand;"/>
                            </VBox>
                        </VBox>

                        <!-- Demande de Démission Card -->
                        <VBox fx:id="cardDemission" spacing="15.0" 
                              style="-fx-border-radius: 15; -fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #f093fb, #f5576c); -fx-padding: 30px; -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.2), 20, 0, 0, 10); -fx-cursor: hand;"
                              HBox.hgrow="ALWAYS">
                            <VBox alignment="CENTER" spacing="15.0">
                                <Label text="📋" style="-fx-font-size: 60px;"/>
                                <Label text="Demande de Démission" 
                                       style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                                <Label text="Soumettre votre démission" 
                                       style="-fx-font-size: 13px; -fx-text-fill: white; -fx-opacity: 0.9;"/>
                                <Button fx:id="btnDemission" text="➜ Accéder" 
                                        style="-fx-background-color: white; -fx-text-fill: #f5576c; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 12px 30px; -fx-background-radius: 25; -fx-cursor: hand;"/>
                            </VBox>
                        </VBox>

                    </HBox>
                </VBox>

            </VBox>
        </VBox>
    </center>

</BorderPane>
