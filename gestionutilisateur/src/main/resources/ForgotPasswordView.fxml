<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.ForgotPasswordController"
            stylesheets="@styleUser.css"
            prefWidth="1440"
            prefHeight="1024">

    <!-- BACKGROUND -->
    <Pane prefWidth="1440"
          prefHeight="1024"
          style="-fx-background-color: #F3F4F6; -fx-background-image: url('/img/mdpbackG.png'); -fx-background-repeat: no-repeat; -fx-background-position: center center; -fx-background-size: 1296px 752px;"/>

    <!-- FORMULAIRE -->
    <VBox prefWidth="360"
          layoutX="800"
          layoutY="160"
          spacing="10"
          alignment="TOP_LEFT"
          style="-fx-background-color: transparent;">

        <Label text="Mot de passe oublié ?" styleClass="title"/>
        <Label text="Recevez un code de vérification par email"
               styleClass="subtitle"/>

        <!-- EMAIL -->
        <Label text="Adresse e-mail" styleClass="fieldLabel"/>
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="inputBox">
            <Label text="📧"/>
            <TextField fx:id="tfEmail"
                       promptText="exemple@gmail.com"
                       styleClass="inputField"/>
        </HBox>

        <!-- BOUTON ENVOYER CODE -->
        <HBox alignment="CENTER" style="-fx-padding: 6 0 0 0;">
            <Button fx:id="btnSendCode"
                    text="📨 Envoyer le code"
                    onAction="#sendVerificationCode"
                    styleClass="btnSignupGlow"/>
        </HBox>

        <!-- CODE DE VÉRIFICATION (caché au début) -->
        <VBox fx:id="codeSection" spacing="14" visible="false" managed="false" style="-fx-padding: 8 0 0 0;">
            <Label text="Code de vérification" styleClass="fieldLabel"/>
            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="inputBox">
                <Label text="🔢"/>
                <TextField fx:id="tfCode"
                           promptText="000000"
                           styleClass="inputField"/>
            </HBox>

            <!-- BOUTON VÉRIFIER CODE -->
            <HBox alignment="CENTER" style="-fx-padding: 6 0 0 0;">
                <Button text="✓ Vérifier le code"
                        onAction="#verifyCode"
                        styleClass="btnSignupGlow"/>
            </HBox>
        </VBox>

        <!-- MESSAGE -->
        <Label fx:id="lblMessage" styleClass="message"/>

        <!-- LIEN RETOUR LOGIN -->
        <HBox spacing="6" alignment="CENTER_LEFT" styleClass="hintRow">
            <Label text="Vous vous souvenez de votre mot de passe ?" styleClass="hintText"/>
            <Hyperlink text="Se connecter"
                       onAction="#goToSignin"
                       styleClass="link"/>
        </HBox>

    </VBox>

</AnchorPane>
