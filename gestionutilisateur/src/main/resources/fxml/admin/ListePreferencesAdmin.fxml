<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.admin.ListePreferencesAdminController"
      spacing="15" style="-fx-padding: 20; -fx-background-color: #f8fafc;">

    <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 0 0 15 0;">
        <VBox spacing="3" HBox.hgrow="ALWAYS">
            <Label text="⭐ Toutes les Préférences Candidats"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
            <Label text="Consultez les préférences de candidature par utilisateur"
                   style="-fx-font-size: 12px; -fx-text-fill: #64748b;"/>
        </VBox>
        <Button text="← Retour aux Candidatures" onAction="#retournerAuxCandidatures"
                style="-fx-background-color: #e5e7eb; -fx-text-fill: #374151; -fx-background-radius: 10; -fx-padding: 10 20; -fx-font-weight: 600; -fx-font-size: 12px; -fx-cursor: hand;"/>
    </HBox>

    <TableView fx:id="tablePreferences" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId"          text="ID"           prefWidth="50"/>
            <TableColumn fx:id="colUtilisateur" text="ID Utilisateur"  prefWidth="120"/>
            <TableColumn fx:id="colTypePoste"   text="Type Poste"   prefWidth="150"/>
            <TableColumn fx:id="colModeTravail" text="Mode Travail" prefWidth="120"/>
            <TableColumn fx:id="colDisponibilite" text="Disponibilité" prefWidth="120"/>
            <TableColumn fx:id="colContrat"     text="Contrat"      prefWidth="100"/>
            <TableColumn fx:id="colSalaire"     text="Salaire (DT)" prefWidth="100"/>
            <TableColumn fx:id="colDateDispo"   text="Date Dispo"   prefWidth="120"/>
            <TableColumn fx:id="colActions"     text="Actions"      prefWidth="150"/>
        </columns>
    </TableView>
</VBox>