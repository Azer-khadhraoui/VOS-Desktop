<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.*?>

<BorderPane
        stylesheets="@../../css/modernRecrutement.css"
        xmlns="http://javafx.com/javafx/17"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="controllers.AdminViewController"
        prefHeight="1024.0" prefWidth="1440.0">

    <!-- ✅ LEFT SIDEBAR SEULEMENT -->
    <left>
        <VBox fx:id="sidebar" styleClass="sidebar" prefWidth="60.0" minWidth="60.0" maxWidth="240.0"
              onMouseEntered="#onSidebarEntered" onMouseExited="#onSidebarExited">

            <!-- Logo -->
            <VBox alignment="CENTER" styleClass="sidebar-logo">
                <padding>
                    <Insets top="15.0" bottom="15.0"/>
                </padding>
                <ImageView fitHeight="60.0" fitWidth="60.0" preserveRatio="true">
                    <image>
                        <Image url="@../../images/VOSwhite.png"/>
                    </image>
                </ImageView>
            </VBox>

            <!-- Navigation Items -->
            <VBox alignment="TOP_CENTER" spacing="12.0" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets top="10.0" left="6.0" right="6.0" />
                </padding>
                
                <HBox fx:id="btnStatistiques" styleClass="sidebar-nav-item">
                    <Label styleClass="sidebar-nav-icon" text="📊" />
                    <Label fx:id="navStatistiquesText" styleClass="sidebar-nav-label" text="Statistiques" />
                </HBox>
                
                <HBox fx:id="btnUtilisateurs" styleClass="sidebar-nav-item">
                    <Label styleClass="sidebar-nav-icon" text="👥" />
                    <Label fx:id="navUtilisateursText" styleClass="sidebar-nav-label" text="Utilisateurs" />
                </HBox>
                
                <HBox fx:id="btnOffres" styleClass="sidebar-nav-item">
                    <Label styleClass="sidebar-nav-icon" text="💼" />
                    <Label fx:id="navOffresText" styleClass="sidebar-nav-label" text="Offres" />
                </HBox>
                
                <HBox fx:id="btnServices" styleClass="sidebar-nav-item">
                    <Label styleClass="sidebar-nav-icon" text="🛠️"/>
                    <Label fx:id="navServicesText" styleClass="sidebar-nav-label" text="Services"/>
                </HBox>

                <HBox fx:id="btnInformations" styleClass="sidebar-nav-item">
                    <Label styleClass="sidebar-nav-icon" text="ℹ️"/>
                    <Label fx:id="navInformationsText" styleClass="sidebar-nav-label" text="Informations"/>
                </HBox>

                <HBox fx:id="navCandidatures" styleClass="sidebar-nav-item">
                    <Label styleClass="sidebar-nav-icon" text="📋" />
                    <Label fx:id="navCandidaturesText" styleClass="sidebar-nav-label" text="Candidatures" />
                </HBox>

                <HBox fx:id="navParametres" styleClass="sidebar-nav-item">
                    <Label styleClass="sidebar-nav-icon" text="⚙️" />
                    <Label fx:id="navParametresText" styleClass="sidebar-nav-label" text="Paramètres" />
                </HBox>

                <HBox fx:id="navProfil" styleClass="sidebar-nav-item">
                    <Label styleClass="sidebar-nav-icon" text="👤"/>
                    <Label fx:id="navProfilText" styleClass="sidebar-nav-label" text="Mon Profil"/>
                </HBox>
                <HBox fx:id="logoutBtn" styleClass="sidebar-nav-item,sidebar-nav-logout" alignment="CENTER_LEFT" spacing="15.0">
                <Label text="➡️" styleClass="sidebar-nav-icon"/>
                <Label text="Déconnexion" styleClass="sidebar-nav-label"/>
            </HBox>
            </VBox>
        </VBox>
    </left>

    <!-- ✅ CENTER: CONTENU DYNAMIQUE SEULEMENT (pas de header) -->
    <center>
        <StackPane fx:id="contentArea" style="-fx-background-color: #F9FAFB;">
            <!-- Les pages seront chargées dynamiquement ici -->
        </StackPane>
    </center>

</BorderPane>