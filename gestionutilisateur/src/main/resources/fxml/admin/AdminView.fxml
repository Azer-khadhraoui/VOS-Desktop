<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.*?>

<BorderPane
        stylesheets="@../../css/modernRecrutement.css"
        xmlns="http://javafx.com/javafx/17"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="controllers.AdminViewController"
        prefHeight="1024.0" prefWidth="1440.0">
    


    <!-- ✅ LEFT SIDEBAR — Collapsible (hover to expand) -->
    <left>
        <VBox fx:id="sidebar" styleClass="sidebar" prefWidth="60.0" minWidth="60.0" maxWidth="240.0"
              style="-fx-background-color: #1a1f3d;"
              onMouseEntered="#onSidebarEntered" onMouseExited="#onSidebarExited">

            <!-- Logo -->
            <VBox alignment="CENTER" styleClass="sidebar-logo">
                <padding>
                    <Insets top="15.0" bottom="15.0"/>
                </padding>
                <ImageView fx:id="sidebarLogo" fitHeight="60.0" fitWidth="60.0" preserveRatio="true">
                    <image>
                        <Image url="@../../images/VOSwhite.png"/>
                    </image>
                </ImageView>
            </VBox>

            <!-- Navigation Items Container -->
            <VBox alignment="TOP_LEFT" spacing="4.0" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets top="15.0" left="8.0" right="8.0"/>
                </padding>

                <!-- Dashboard Section (non-clickable header) -->
                <HBox fx:id="navDashboard" styleClass="sidebar-nav-item, sidebar-nav-item-active">
                    <Label styleClass="sidebar-nav-icon" text="📊"/>
                    <Label fx:id="lblDashboardSection" styleClass="sidebar-nav-label-large" text="DASHBOARD"/>
                </HBox>

                <!-- Spacer -->
                <VBox style="-fx-min-height: 12.0;"/>

                <!-- GESTIONS Section -->
                <Label fx:id="lblGestionsSection" text="GESTIONS" styleClass="sidebar-section-title"/>
                <TitledPane fx:id="gestionsPane" styleClass="sidebar-titled-pane" animated="true" collapsible="true">
                    <graphic>
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <Label styleClass="sidebar-nav-icon" text="🛠️"/>
                            <Label fx:id="lblGestionsText" styleClass="sidebar-nav-label" text="Gestions"/>
                        </HBox>
                    </graphic>
                    <VBox spacing="4.0" style="-fx-padding: 8 0 0 0;">
                        <HBox fx:id="menuOffres" styleClass="sidebar-submenu-item">
                            <Label styleClass="sidebar-nav-label" text="Offres d'Emploi"/>
                        </HBox>
                        <HBox fx:id="menuEntretiens" styleClass="sidebar-submenu-item">
                            <Label styleClass="sidebar-nav-label" text="Entretiens"/>
                        </HBox>
                        <HBox fx:id="menuRecrutement" styleClass="sidebar-submenu-item">
                            <Label styleClass="sidebar-nav-label" text="Recrutement &amp; Contrats"/>
                        </HBox>
                        <HBox fx:id="menuCandidatures" styleClass="sidebar-submenu-item">
                            <Label styleClass="sidebar-nav-label" text="Gestion Candidatures"/>
                        </HBox>
                        <HBox fx:id="menuAdministration" styleClass="sidebar-submenu-item">
                            <Label styleClass="sidebar-nav-label" text="Utilisateurs"/>
                        </HBox>
                        <HBox fx:id="menuServices" styleClass="sidebar-submenu-item">
                            <Label styleClass="sidebar-nav-label" text="Services"/>
                        </HBox>
                    </VBox>
                </TitledPane>

                <!-- Spacer -->
                <VBox style="-fx-min-height: 12.0;"/>

                <!-- STATISTIQUES & Section -->
                <Label fx:id="lblStatistiquesSection" text="STATISTIQUES" styleClass="sidebar-section-title"/>
                <TitledPane fx:id="statsPane" styleClass="sidebar-titled-pane" animated="true" collapsible="true">
                    <graphic>
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <Label styleClass="sidebar-nav-icon" text="📈"/>
                            <Label fx:id="lblStatsText" styleClass="sidebar-nav-label" text="Statistiques"/>
                        </HBox>
                    </graphic>
                    <VBox spacing="4.0" style="-fx-padding: 8 0 0 0;">
                        <HBox fx:id="menuStatistiques" styleClass="sidebar-submenu-item">
                            <Label styleClass="sidebar-nav-label" text="Statistiques"/>
                        </HBox>
                    </VBox>
                </TitledPane>
            </VBox>

            <!-- Spacer -->
            <VBox VBox.vgrow="ALWAYS"/>

            <!-- Logout at bottom -->
            <HBox fx:id="navLogout" styleClass="sidebar-nav-item, sidebar-nav-logout">
                <Label styleClass="sidebar-nav-icon" text="🚪"/>
                <Label fx:id="navLogoutText" styleClass="sidebar-nav-label" text="Déconnexion"/>
            </HBox>

            <VBox style="-fx-min-height: 8.0;"/>
        </VBox>
    </left>

    <!-- ✅ CENTER: CONTENU DYNAMIQUE (chargé par le contrôleur) -->
    <center>
        <StackPane fx:id="contentArea" style="-fx-background-color: #F9FAFB;">
            <!-- Les pages seront chargées dynamiquement ici -->
        </StackPane>
    </center>

</BorderPane>
