<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17"
       xmlns:fx="http://javafx.com/fxml/1"
       fx:controller="controllers.TestLauncherController"
       prefHeight="620.0" prefWidth="520.0"
       spacing="0"
       style="-fx-background-color: #f8fafc; -fx-font-family: 'Segoe UI', Arial;">

       <!-- ═══════════════ HEADER ═══════════════ -->
       <VBox alignment="CENTER" spacing="8"
              style="-fx-background-color: #1e3a8a; -fx-padding: 38 40 32 40;">
              <Label text="VOS"
                     style="-fx-font-size: 40px; -fx-font-weight: 800; -fx-text-fill: white;" />
              <Label text="Gestion des Candidatures"
                     style="-fx-font-size: 15px; -fx-text-fill: #93c5fd; -fx-font-weight: 600;" />
              <Label text="Choisissez une vue à tester — connexion simulée"
                     style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.45); -fx-padding: 4 0 0 0;" />
       </VBox>

       <VBox spacing="20" VBox.vgrow="ALWAYS"
              style="-fx-padding: 32 36 36 36; -fx-background-color: #f8fafc;">

              <VBox spacing="10"
                     style="-fx-background-color: white; -fx-background-radius: 14;
                     -fx-padding: 18 20; -fx-border-color: #e2e8f0; -fx-border-width: 1;
                     -fx-border-radius: 14;">
                     <Label text="🔧  Configuration du test"
                            style="-fx-font-size: 13px; -fx-font-weight: 700; -fx-text-fill: #374151;" />
                     <HBox spacing="12" alignment="CENTER_LEFT">
                            <Label text="ID Utilisateur simulé :"
                                   style="-fx-font-size: 13px; -fx-text-fill: #475569;" />
                            <TextField fx:id="fieldUserId"
                                   text="1"
                                   prefWidth="80"
                                   style="-fx-background-radius: 8; -fx-border-radius: 8;
                                  -fx-border-color: #cbd5e1; -fx-background-color: white;
                                  -fx-padding: 6 12; -fx-font-size: 13px;" />
                            <Label text="(simule l'utilisateur connecté)"
                                   style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;" />
                     </HBox>
              </VBox>

              <VBox spacing="10"
                     style="-fx-background-color: white; -fx-background-radius: 14;
                     -fx-padding: 18 20; -fx-border-color: #dbeafe; -fx-border-width: 1.5;
                     -fx-border-radius: 14;
                     -fx-effect: dropshadow(gaussian, rgba(37,99,235,0.07), 14, 0, 0, 4);">

                     <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="👔" style="-fx-font-size: 18px;" />
                            <Label text="Vue Administrateur RH"
                                   style="-fx-font-size: 14px; -fx-font-weight: 700; -fx-text-fill: #1e40af;" />
                     </HBox>

                     <Button text="📋   Liste de toutes les candidatures"
                            onAction="#ouvrirAdminListe"
                            maxWidth="Infinity"
                            style="-fx-background-color: #2563eb; -fx-text-fill: white;
                           -fx-font-size: 13px; -fx-font-weight: 700;
                           -fx-padding: 13 20; -fx-background-radius: 10; -fx-cursor: hand;
                           -fx-effect: dropshadow(gaussian, rgba(37,99,235,0.3), 10, 0, 0, 3);" />

                     <Button text="➕   Formulaire ajout / modification (admin)"
                            onAction="#ouvrirAdminForm"
                            maxWidth="Infinity"
                            style="-fx-background-color: #eff6ff; -fx-text-fill: #2563eb;
                           -fx-font-size: 13px; -fx-font-weight: 600;
                           -fx-padding: 13 20; -fx-background-radius: 10;
                           -fx-border-color: #bfdbfe; -fx-border-width: 1.5;
                           -fx-border-radius: 10; -fx-cursor: hand;" />
              </VBox>

              <HBox spacing="12" alignment="CENTER">
                     <Region HBox.hgrow="ALWAYS"
                            style="-fx-background-color: #e2e8f0; -fx-pref-height: 1; -fx-max-height: 1;" />
                     <Label text="ou"
                            style="-fx-font-size: 12px; -fx-text-fill: #94a3b8; -fx-font-weight: 600;" />
                     <Region HBox.hgrow="ALWAYS"
                            style="-fx-background-color: #e2e8f0; -fx-pref-height: 1; -fx-max-height: 1;" />
              </HBox>

              <VBox spacing="10"
                     style="-fx-background-color: white; -fx-background-radius: 14;
                     -fx-padding: 18 20; -fx-border-color: #e0e7ff; -fx-border-width: 1.5;
                     -fx-border-radius: 14;
                     -fx-effect: dropshadow(gaussian, rgba(99,102,241,0.07), 14, 0, 0, 4);">

                     <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="👤" style="-fx-font-size: 18px;" />
                            <Label text="Vue Candidat (Utilisateur)"
                                   style="-fx-font-size: 14px; -fx-font-weight: 700; -fx-text-fill: #4f46e5;" />
                     </HBox>

                     <Button text="📋   Mes candidatures (vue cards)"
                            onAction="#ouvrirUserListe"
                            maxWidth="Infinity"
                            style="-fx-background-color: linear-gradient(to right, #6366f1, #8b5cf6);
                           -fx-text-fill: white;
                           -fx-font-size: 13px; -fx-font-weight: 700;
                           -fx-padding: 13 20; -fx-background-radius: 10; -fx-cursor: hand;
                           -fx-effect: dropshadow(gaussian, rgba(99,102,241,0.35), 10, 0, 0, 3);" />

                     <Button text="➕   Formulaire postuler (utilisateur)"
                            onAction="#ouvrirUserForm"
                            maxWidth="Infinity"
                            style="-fx-background-color: #eef2ff; -fx-text-fill: #6366f1;
                           -fx-font-size: 13px; -fx-font-weight: 600;
                           -fx-padding: 13 20; -fx-background-radius: 10;
                           -fx-border-color: #c7d2fe; -fx-border-width: 1.5;
                           -fx-border-radius: 10; -fx-cursor: hand;" />

                     <Button text="🔍   Détail candidature (vue split)"
                            onAction="#ouvrirUserDetail"
                            maxWidth="Infinity"
                            style="-fx-background-color: #f5f3ff; -fx-text-fill: #7c3aed;
                           -fx-font-size: 13px; -fx-font-weight: 600;
                           -fx-padding: 13 20; -fx-background-radius: 10;
                           -fx-border-color: #ddd6fe; -fx-border-width: 1.5;
                           -fx-border-radius: 10; -fx-cursor: hand;" />
                     <Button text="🎯 Matching Offres"
                            onAction="#ouvrirUserMatching"
                            style="-fx-background-color: #27AE60; -fx-text-fill: white;
               -fx-pref-width: 200; -fx-padding: 8 0; -fx-cursor: hand;" />
              </VBox>

              <Label fx:id="errorLabel" text=""
                     style="-fx-text-fill: #ef4444; -fx-font-size: 12px;"
                     visible="false" managed="false" />
       </VBox>
</VBox>