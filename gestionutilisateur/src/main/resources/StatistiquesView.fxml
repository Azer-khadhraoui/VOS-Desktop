<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>

<BorderPane prefHeight="1024.0" prefWidth="1440.0" stylesheets="@AdministrationView.css" 
            xmlns="http://javafx.com/javafx/17" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="controllers.StatistiquesController">

    <!-- SIDEBAR -->
    <left>
        <VBox fx:id="sidebar" styleClass="sidebar" prefWidth="80.0">
            <VBox alignment="CENTER" styleClass="sidebar-logo">
                <ImageView fitHeight="55" fitWidth="55" preserveRatio="true">
                    <Image url="@img/VOSwhiteslogan.png"/>
                </ImageView>
            </VBox>

            <VBox fx:id="navContainer" alignment="TOP_CENTER" spacing="20.0" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets top="30.0"/>
                </padding>

                <HBox fx:id="btnStatistiques" styleClass="sidebar-nav-item" alignment="CENTER_LEFT" spacing="15.0">
                    <Label text="📊" styleClass="sidebar-nav-icon"/>
                    <Label text="Statistiques" styleClass="sidebar-nav-label"/>
                </HBox>
                <HBox fx:id="btnUtilisateurs" styleClass="sidebar-nav-item,sidebar-nav-active" alignment="CENTER_LEFT" spacing="15.0" onMouseClicked="#goToAdmin">
                    <Label text="👥" styleClass="sidebar-nav-icon"/>
                    <Label text="Utilisateurs" styleClass="sidebar-nav-label"/>
                </HBox>
                <HBox fx:id="btnOffres" styleClass="sidebar-nav-item" alignment="CENTER_LEFT" spacing="15.0">
                    <Label text="💼" styleClass="sidebar-nav-icon"/>
                    <Label text="Offres" styleClass="sidebar-nav-label"/>
                </HBox>
                <HBox fx:id="logoutBtn" styleClass="sidebar-nav-item,sidebar-nav-logout" alignment="CENTER_LEFT" spacing="15.0" onMouseClicked="#logout">
                    <Label text="➡️" styleClass="sidebar-nav-icon"/>
                    <Label text="Déconnexion" styleClass="sidebar-nav-label"/>
                </HBox>
            </VBox>
        </VBox>
    </left>

    <!-- CONTENT -->
    <center>
        <VBox style="-fx-background-color: #F5F7FA;">
            
            <!-- HEADER -->
            <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="20.0">
                <padding>
                    <Insets top="20.0" right="30.0" bottom="20.0" left="30.0"/>
                </padding>

                <VBox spacing="5">
                    <Label text="📊 Tableau de bord" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1F2937;"/>
                    <Label text="Vue d'ensemble des statistiques" style="-fx-font-size: 13px; -fx-text-fill: #6B7280;"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>
                
                <!-- Bouton Export -->
                <Button text="📥 Exporter" onAction="#exportData" style="-fx-background-color: #6366F1; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 600; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand; -fx-border-width: 0;"/>
                
                <!-- User Profile -->
                <HBox spacing="15.0" alignment="CENTER">
                    <StackPane fx:id="userAvatarContainer" styleClass="user-avatar-container">
                        <Label fx:id="lblUserAvatar" text="👤" styleClass="user-avatar"/>
                    </StackPane>
                    <VBox alignment="CENTER_LEFT" spacing="2.0">
                        <Label fx:id="lblUserName" text="Admin" styleClass="user-name"/>
                        <Label fx:id="lblUserRole" text="ADMIN" styleClass="user-role"/>
                    </VBox>
                </HBox>
            </HBox>

            <!-- SCROLLABLE CONTENT -->
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-border-width: 0;">
                <VBox spacing="25" style="-fx-padding: 30;">
                    
                    <!-- CARTES KPI -->
                    <GridPane hgap="20" vgap="20">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="33.33"/>
                            <ColumnConstraints percentWidth="33.33"/>
                            <ColumnConstraints percentWidth="33.34"/>
                        </columnConstraints>

                        <!-- Total Utilisateurs -->
                        <VBox spacing="15" style="-fx-background-color: #6366F1; -fx-background-radius: 15; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(99,102,241,0.4), 20, 0, 0, 8);" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <HBox alignment="CENTER_LEFT" spacing="15">
                                <StackPane style="-fx-background-color: rgba(255,255,255,0.2); -fx-background-radius: 12; -fx-min-width: 50; -fx-min-height: 50;">
                                    <Label text="👥" style="-fx-font-size: 24px;"/>
                                </StackPane>
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label text="Utilisateurs" style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.9);"/>
                                    <Label fx:id="lblTotalUsers" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                                </VBox>
                            </HBox>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label text="↗" style="-fx-font-size: 18px; -fx-text-fill: #4ADE80;"/>
                                <Label fx:id="lblUsersGrowth" text="+12% ce mois" style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.85);"/>
                            </HBox>
                        </VBox>

                        <!-- Clients -->
                        <VBox spacing="15" style="-fx-background-color: #EC4899; -fx-background-radius: 15; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(236,72,153,0.4), 20, 0, 0, 8);" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <HBox alignment="CENTER_LEFT" spacing="15">
                                <StackPane style="-fx-background-color: rgba(255,255,255,0.2); -fx-background-radius: 12; -fx-min-width: 50; -fx-min-height: 50;">
                                    <Label text="🎯" style="-fx-font-size: 24px;"/>
                                </StackPane>
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label text="Clients" style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.9);"/>
                                    <Label fx:id="lblTotalClients" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                                </VBox>
                            </HBox>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label text="↗" style="-fx-font-size: 18px; -fx-text-fill: #4ADE80;"/>
                                <Label fx:id="lblClientsGrowth" text="+8% ce mois" style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.85);"/>
                            </HBox>
                        </VBox>

                        <!-- Admins -->
                        <VBox spacing="15" style="-fx-background-color: #06B6D4; -fx-background-radius: 15; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(6,182,212,0.4), 20, 0, 0, 8);" GridPane.columnIndex="2" GridPane.rowIndex="0">
                            <HBox alignment="CENTER_LEFT" spacing="15">
                                <StackPane style="-fx-background-color: rgba(255,255,255,0.2); -fx-background-radius: 12; -fx-min-width: 50; -fx-min-height: 50;">
                                    <Label text="🛡️" style="-fx-font-size: 24px;"/>
                                </StackPane>
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label text="Admins" style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.9);"/>
                                    <Label fx:id="lblTotalAdmins" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                                </VBox>
                            </HBox>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label text="→" style="-fx-font-size: 18px; -fx-text-fill: #FCD34D;"/>
                                <Label text="Stable" style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.85);"/>
                            </HBox>
                        </VBox>
                    </GridPane>

                    <!-- GRAPHIQUES -->
                    <GridPane hgap="20" vgap="20">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="100"/>
                        </columnConstraints>

                        <!-- Répartition par rôle -->
                        <VBox spacing="20" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 3);" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <HBox alignment="CENTER_LEFT" spacing="15">
                                <Label text="🎯" style="-fx-font-size: 20px;"/>
                                <Label text="Répartition par rôle" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1F2937;"/>
                            </HBox>
                            <PieChart fx:id="pieChart" legendVisible="false" prefHeight="300" style="-fx-background-color: transparent;"/>
                        </VBox>
                    </GridPane>

                    <!-- ACTIVITÉ RÉCENTE -->
                    <VBox spacing="20" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 3);">
                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <Label text="🕒" style="-fx-font-size: 20px;"/>
                            <Label text="Activité récente" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1F2937;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="🔄 Actualiser" onAction="#refreshStats" style="-fx-background-color: #F3F4F6; -fx-text-fill: #6B7280; -fx-font-size: 12px; -fx-padding: 8 16; -fx-background-radius: 8; -fx-cursor: hand; -fx-border-width: 0;"/>
                        </HBox>
                        
                        <VBox fx:id="activityContainer" spacing="12"/>
                    </VBox>

                </VBox>
            </ScrollPane>

        </VBox>
    </center>

</BorderPane>
