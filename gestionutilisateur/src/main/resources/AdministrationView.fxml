<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane prefHeight="1024.0" prefWidth="1440.0"
           minHeight="1024.0" minWidth="1440.0"
           maxHeight="1024.0" maxWidth="1440.0" 
           xmlns="http://javafx.com/javafx/17" 
           xmlns:fx="http://javafx.com/fxml/1" 
           fx:controller="controllers.AdministrationController">

<BorderPane prefHeight="1024.0" prefWidth="1440.0" stylesheets="@modernuser.css">

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox styleClass="sidebar" prefWidth="80.0">
            <!-- Logo -->
            <VBox alignment="CENTER" styleClass="logo-container">
                <Label text="VOS" styleClass="logo-text"/>
            </VBox>

            <!-- Navigation Icons -->
            <VBox alignment="TOP_CENTER" spacing="20.0" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets top="30.0"/>
                </padding>

                <Button styleClass="nav-icon" text="📊"/>
                <Button styleClass="nav-icon" text="💼"/>
                <Button styleClass="nav-icon" text="ℹ️"/>
                <Button styleClass="nav-icon" text="👤"/>
                <Button styleClass="nav-icon" text="⚙️"/>
                <Button styleClass="nav-icon" text="➡️" onAction="#logout"/>
            </VBox>
        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <VBox>
            <!-- TOP HEADER BAR -->
            <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="20.0">
                <padding>
                    <Insets top="20.0" right="30.0" bottom="20.0" left="30.0"/>
                </padding>

                <!-- Search Bar -->
                <TextField fx:id="searchField" promptText="🔍 Rechercher..." styleClass="search-bar" prefWidth="400.0"/>

                <!-- Spacer -->
                <Region HBox.hgrow="ALWAYS"/>

                <!-- Dark/Light Toggle -->
                <HBox spacing="10.0" alignment="CENTER">
                    <Label text="🌙" styleClass="toggle-icon"/>
                    <ToggleButton styleClass="theme-toggle"/>
                    <Label text="☀️" styleClass="toggle-icon"/>
                </HBox>

                <!-- User Profile -->
                <HBox spacing="15.0" alignment="CENTER">
                    <StackPane fx:id="userAvatarContainer" styleClass="user-avatar-container">
                        <Label fx:id="lblUserAvatar" text="👤" styleClass="user-avatar"/>
                    </StackPane>
                    <VBox alignment="CENTER_LEFT" spacing="2.0">
                        <Label fx:id="lblUserName" text="Mohamed Azer Khadhraoui" styleClass="user-name"/>
                        <Label fx:id="lblUserRole" text="CLIENT" styleClass="user-role"/>
                    </VBox>
                </HBox>
            </HBox>

            <!-- MAIN CONTENT AREA -->
            <VBox spacing="25.0" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
                </padding>

                <!-- Page Header -->
                <HBox alignment="CENTER_LEFT" spacing="20.0">
                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                        <HBox spacing="15.0" alignment="CENTER_LEFT">
                            <Label text="👥" style="-fx-font-size: 32px;"/>
                            <VBox spacing="2.0">
                                <Label text="Administration" styleClass="page-title"/>
                                <Label text="Gérez vos utilisateurs" styleClass="page-subtitle"/>
                            </VBox>
                        </HBox>
                    </VBox>
                    <Button text="➕ Ajouter utilisateur" onAction="#showAddUserModal" styleClass="btn-add"/>
                </HBox>

                <!-- Table -->
                <TableView fx:id="tableUsers" styleClass="modern-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" text="#" prefWidth="50.0"/>
                        <TableColumn fx:id="colNom" text="Nom" prefWidth="220.0"/>
                        <TableColumn fx:id="colPrenom" text="Prénom" prefWidth="150.0"/>
                        <TableColumn fx:id="colEmail" text="Email" prefWidth="250.0"/>
                        <TableColumn fx:id="colPassword" text="Mot de passe" prefWidth="150.0"/>
                        <TableColumn fx:id="colRole" text="Role" prefWidth="180.0"/>
                        <TableColumn fx:id="colActions" text="Actions" prefWidth="150.0"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>

<!-- MODAL OVERLAY (Hidden by default) -->
<StackPane fx:id="modalOverlay" visible="false" managed="false"
           alignment="CENTER"
           style="-fx-background-color: rgba(17, 24, 39, 0.7);">
    
    <VBox fx:id="modalContent" alignment="CENTER" maxWidth="520.0" minWidth="520.0" spacing="0.0"
          style="-fx-background-color: white; -fx-background-radius: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 50, 0, 0, 15);">
        
        <!-- Header avec dégradé -->
        <HBox alignment="CENTER" spacing="15.0" 
              style="-fx-background-color: linear-gradient(from 0% 0% to 100% 0%, #667eea, #764ba2); -fx-background-radius: 24 24 0 0; -fx-padding: 25 30;">
            <Label fx:id="modalTitle" text="➕ Ajouter un utilisateur" 
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;" HBox.hgrow="ALWAYS"/>
            <Button text="✕" onAction="#closeModal" 
                    style="-fx-background-color: rgba(255,255,255,0.2); -fx-background-radius: 50; -fx-font-size: 16px; -fx-cursor: hand; -fx-text-fill: white; -fx-min-width: 35; -fx-min-height: 35;"/>
        </HBox>
        
        <VBox spacing="22.0" style="-fx-padding: 30 35;">

            <!-- Photo de profil avec cercle stylé -->
            <VBox spacing="12.0" alignment="CENTER">
                <StackPane style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #667eea, #764ba2); -fx-background-radius: 70; -fx-padding: 4;">
                    <StackPane fx:id="profileImageContainer" 
                               style="-fx-background-color: white; -fx-background-radius: 66; -fx-min-width: 110; -fx-min-height: 110; -fx-max-width: 110; -fx-max-height: 110;">
                        <Label fx:id="lblProfileIcon" text="👤" style="-fx-font-size: 50px;"/>
                    </StackPane>
                </StackPane>
                <Button text="📷 Changer la photo" onAction="#uploadImage" 
                        style="-fx-background-color: #F3F4F6; -fx-text-fill: #4B5563; -fx-font-size: 13px; -fx-font-weight: 600; -fx-padding: 10 20; -fx-background-radius: 20; -fx-cursor: hand;"/>
            </VBox>

            <!-- Form Fields avec icônes -->
            <VBox spacing="16.0">
                <!-- Nom -->
                <VBox spacing="6.0">
                    <Label text="👤 Nom" style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #374151;"/>
                    <TextField fx:id="tfNom" promptText="Entrez le nom" 
                               style="-fx-background-color: #F9FAFB; -fx-background-radius: 12; -fx-border-color: #E5E7EB; -fx-border-radius: 12; -fx-padding: 14 16; -fx-font-size: 14px;"/>
                </VBox>

                <!-- Prénom -->
                <VBox spacing="6.0">
                    <Label text="✨ Prénom" style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #374151;"/>
                    <TextField fx:id="tfPrenom" promptText="Entrez le prénom" 
                               style="-fx-background-color: #F9FAFB; -fx-background-radius: 12; -fx-border-color: #E5E7EB; -fx-border-radius: 12; -fx-padding: 14 16; -fx-font-size: 14px;"/>
                </VBox>

                <!-- Email -->
                <VBox spacing="6.0">
                    <Label text="📧 Email" style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #374151;"/>
                    <TextField fx:id="tfEmail" promptText="exemple@gmail.com" 
                               style="-fx-background-color: #F9FAFB; -fx-background-radius: 12; -fx-border-color: #E5E7EB; -fx-border-radius: 12; -fx-padding: 14 16; -fx-font-size: 14px;"/>
                </VBox>

                <!-- Mot de passe -->
                <VBox spacing="6.0">
                    <Label text="🔒 Mot de passe" style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #374151;"/>
                    <PasswordField fx:id="tfPassword" promptText="••••••••" 
                                   style="-fx-background-color: #F9FAFB; -fx-background-radius: 12; -fx-border-color: #E5E7EB; -fx-border-radius: 12; -fx-padding: 14 16; -fx-font-size: 14px;"/>
                </VBox>

                <!-- Rôle -->
                <VBox spacing="6.0">
                    <Label text="🎭 Rôle" style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #374151;"/>
                    <ComboBox fx:id="cbRole" promptText="Sélectionnez un rôle" prefWidth="450.0"
                              style="-fx-background-color: #F9FAFB; -fx-background-radius: 12; -fx-border-color: #E5E7EB; -fx-border-radius: 12; -fx-padding: 10 12; -fx-font-size: 14px;"/>
                </VBox>
            </VBox>

            <!-- Action Buttons -->
            <HBox spacing="15.0" alignment="CENTER" style="-fx-padding: 15 0 5 0;">
                <Button text="✕ Annuler" onAction="#closeModal" 
                        style="-fx-background-color: white; -fx-text-fill: #6B7280; -fx-font-size: 14px; -fx-font-weight: 600; -fx-padding: 14 35; -fx-background-radius: 12; -fx-border-color: #E5E7EB; -fx-border-radius: 12; -fx-cursor: hand;"/>
                <Button fx:id="btnSave" text="💾 Enregistrer" onAction="#saveUser" 
                        style="-fx-background-color: linear-gradient(from 0% 0% to 100% 0%, #667eea, #764ba2); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: 600; -fx-padding: 14 35; -fx-background-radius: 12; -fx-cursor: hand;"/>
            </HBox>

            <!-- Message Label -->
            <Label fx:id="lblModalMessage" style="-fx-font-size: 13px; -fx-text-alignment: center; -fx-text-fill: #EF4444;" alignment="CENTER"/>
        </VBox>
    </VBox>
</StackPane>
        
<!-- MODAL CONFIRMATION SUPPRESSION -->
<StackPane fx:id="deleteModalOverlay" 
           visible="false" 
           managed="false"
           alignment="CENTER"
           style="-fx-background-color: rgba(0, 0, 0, 0.6);">
            <VBox fx:id="deleteModalContent" 
                  spacing="20.0" 
                  alignment="CENTER"
                  StackPane.alignment="CENTER"
                  style="-fx-background-color: white; -fx-background-radius: 20px; -fx-padding: 40px; -fx-max-width: 480px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 30, 0, 0, 10);">
                
                <!-- Icône d'avertissement animée -->
                <StackPane style="-fx-background-color: #FEE2E2; -fx-background-radius: 60px; -fx-pref-width: 120px; -fx-pref-height: 120px;">
                    <Label fx:id="lblDeleteIcon" text="⚠️" style="-fx-font-size: 60px;"/>
                </StackPane>
                
                <!-- Titre -->
                <Label text="Confirmation de suppression" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                
                <!-- Détails utilisateur -->
                <VBox spacing="8" alignment="CENTER" style="-fx-background-color: #F9FAFB; -fx-background-radius: 12px; -fx-padding: 20px;">
                    <Label text="Voulez-vous vraiment supprimer cet utilisateur ?" style="-fx-font-size: 14px; -fx-text-fill: #6B7280;"/>
                    <Label fx:id="lblDeleteUserInfo" style="-fx-font-size: 15px; -fx-font-weight: 600; -fx-text-fill: #374151; -fx-padding: 10 0 0 0;"/>
                </VBox>
                
                <!-- Message d'avertissement -->
                <HBox spacing="10" alignment="CENTER" style="-fx-background-color: #FEF2F2; -fx-background-radius: 10px; -fx-padding: 15px;">
                    <Label text="⚠️" style="-fx-font-size: 20px;"/>
                    <Label text="Cette action est irréversible !" style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #DC2626;"/>
                </HBox>
                
                <!-- Boutons d'action -->
                <HBox spacing="15" alignment="CENTER">
                    <Button text="❌ Annuler" 
                            onAction="#closeDeleteModal" 
                            style="-fx-background-color: #F3F4F6; -fx-text-fill: #374151; -fx-font-size: 14px; -fx-font-weight: 600; -fx-padding: 12px 30px; -fx-background-radius: 10px; -fx-cursor: hand;"/>
                    <Button fx:id="btnConfirmDelete" 
                            text="🗑️ Supprimer définitivement" 
                            onAction="#confirmDelete" 
                            style="-fx-background-color: #DC2626; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: 600; -fx-padding: 12px 30px; -fx-background-radius: 10px; -fx-cursor: hand;"/>
                </HBox>
            </VBox>
        </StackPane>

</StackPane>
