<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.geometry.Insets?>

<StackPane prefHeight="1024.0" prefWidth="1440.0"
           minHeight="1024.0" minWidth="1440.0"
           maxHeight="1024.0" maxWidth="1440.0" 
           xmlns="http://javafx.com/javafx/17" 
           xmlns:fx="http://javafx.com/fxml/1" 
           fx:controller="controllers.AdministrationController">

<BorderPane prefHeight="1024.0" prefWidth="1440.0" stylesheets="@AdministrationView.css">

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox fx:id="sidebar" styleClass="sidebar" prefWidth="80.0">
            <!-- Logo -->
            <VBox alignment="CENTER" styleClass="sidebar-logo">
                <ImageView fitHeight="55" fitWidth="55" preserveRatio="true">
                    <Image url="@img/VOSwhiteslogan.png"/>
                </ImageView>
            </VBox>

            <!-- Navigation Icons -->
            <VBox fx:id="navContainer" alignment="TOP_CENTER" spacing="20.0" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets top="30.0"/>
                </padding>

                <HBox fx:id="btnStatistiques" styleClass="sidebar-nav-item" alignment="CENTER_LEFT" spacing="15.0">
                    <Label text="📊" styleClass="sidebar-nav-icon"/>
                    <Label text="Statistiques" styleClass="sidebar-nav-label"/>
                </HBox>
                <HBox fx:id="btnOffres" styleClass="sidebar-nav-item" alignment="CENTER_LEFT" spacing="15.0">
                    <Label text="💼" styleClass="sidebar-nav-icon"/>
                    <Label text="Offres" styleClass="sidebar-nav-label"/>
                </HBox>
                <HBox styleClass="sidebar-nav-item" alignment="CENTER_LEFT" spacing="15.0">
                    <Label text="ℹ️" styleClass="sidebar-nav-icon"/>
                    <Label text="Informations" styleClass="sidebar-nav-label"/>
                </HBox>
                <HBox styleClass="sidebar-nav-item" alignment="CENTER_LEFT" spacing="15.0">
                    <Label text="⚙️" styleClass="sidebar-nav-icon"/>
                    <Label text="Paramètres" styleClass="sidebar-nav-label"/>
                </HBox>
                <HBox fx:id="logoutBtn" styleClass="sidebar-nav-item,sidebar-nav-logout" alignment="CENTER_LEFT" spacing="15.0">
                    <Label text="➡️" styleClass="sidebar-nav-icon"/>
                    <Label text="Déconnexion" styleClass="sidebar-nav-label"/>
                </HBox>
            </VBox>
        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <VBox>
            <!-- TOP HEADER BAR -->
            <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="20.0">
                <padding>
                    <Insets top="20.0" right="30.0" bottom="20.0" left="30.0"/>
                </padding>

                <!-- Search Bar -->
                <TextField fx:id="searchField" promptText="🔍 Rechercher..." styleClass="search-bar" prefWidth="400.0"/>

                <!-- Spacer -->
                <Region HBox.hgrow="ALWAYS"/>

                <!-- Dark/Light Toggle -->
                <HBox spacing="10.0" alignment="CENTER">
                    <Label text="🌙" styleClass="toggle-icon"/>
                    <ToggleButton styleClass="theme-toggle"/>
                    <Label text="☀️" styleClass="toggle-icon"/>
                </HBox>

                <!-- User Profile -->
                <HBox spacing="15.0" alignment="CENTER">
                    <StackPane fx:id="userAvatarContainer" styleClass="user-avatar-container">
                        <Label fx:id="lblUserAvatar" text="👤" styleClass="user-avatar"/>
                    </StackPane>
                    <VBox alignment="CENTER_LEFT" spacing="2.0">
                        <Label fx:id="lblUserName" text="Mohamed Azer Khadhraoui" styleClass="user-name"/>
                        <Label fx:id="lblUserRole" text="CLIENT" styleClass="user-role"/>
                    </VBox>
                </HBox>
            </HBox>

            <!-- MAIN CONTENT AREA -->
            <VBox spacing="25.0" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
                </padding>

                <!-- Page Header -->
                <HBox alignment="CENTER_LEFT" spacing="20.0">
                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                        <HBox spacing="15.0" alignment="CENTER_LEFT">
                            <Label text="👥" style="-fx-font-size: 32px;"/>
                            <VBox spacing="2.0">
                                <Label text="Administration" styleClass="page-title"/>
                                <Label text="Gérez vos utilisateurs" styleClass="page-subtitle"/>
                            </VBox>
                        </HBox>
                    </VBox>
                    <Button text="➕ Ajouter utilisateur" onAction="#showAddUserModal" styleClass="btn-add"/>
                </HBox>

                <!-- Filtres avancés -->
                <HBox spacing="15.0" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 5);">
                    <Label text="🔍 Filtres:" style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #374151;"/>
                    
                    <ComboBox fx:id="filterRole" promptText="Filtrer par rôle" prefWidth="180.0" style="-fx-background-color: #F3F4F6; -fx-background-radius: 8; -fx-border-color: #E5E7EB; -fx-border-radius: 8; -fx-padding: 8 12;"/>
                    
                    <Button text="🔄 Réinitialiser" onAction="#resetFilters" style="-fx-background-color: #EFF6FF; -fx-text-fill: #1E40AF; -fx-font-size: 12px; -fx-font-weight: 600; -fx-padding: 8 16; -fx-background-radius: 8; -fx-border-width: 0; -fx-cursor: hand;"/>
                    
                    <Region HBox.hgrow="ALWAYS"/>
                    
                    <Label fx:id="lblTotalCount" text="Total: 0 utilisateurs" style="-fx-font-size: 13px; -fx-text-fill: #6B7280; -fx-font-weight: 500;"/>
                </HBox>

                <!-- Table -->
                <TableView fx:id="tableUsers" styleClass="modern-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" text="#" prefWidth="50.0"/>
                        <TableColumn fx:id="colNom" text="Nom" prefWidth="220.0"/>
                        <TableColumn fx:id="colPrenom" text="Prénom" prefWidth="150.0"/>
                        <TableColumn fx:id="colEmail" text="Email" prefWidth="250.0"/>
                        <TableColumn fx:id="colPassword" text="Mot de passe" prefWidth="150.0"/>
                        <TableColumn fx:id="colRole" text="Role" prefWidth="180.0"/>
                        <TableColumn fx:id="colActions" text="Actions" prefWidth="150.0"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>

<!-- MODAL OVERLAY (Hidden by default) -->
<StackPane fx:id="modalOverlay" visible="false" managed="false"
           alignment="CENTER"
           style="-fx-background-color: rgba(0, 0, 0, 0.75);">
    
    <VBox fx:id="modalContent" alignment="CENTER" maxWidth="480.0" minWidth="480.0" spacing="0.0"
          style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #1a1a2e, #16213e); -fx-background-radius: 28; -fx-effect: dropshadow(gaussian, rgba(102, 126, 234, 0.5), 60, 0, 0, 0);">
        
        <!-- Header avec logo animé -->
        <VBox alignment="CENTER" spacing="8.0" 
              style="-fx-background-color: transparent; -fx-padding: 30 30 20 30;">
            <ImageView fitHeight="80.0" fitWidth="180.0" preserveRatio="true">
                <Image url="@img/VOSwhiteslogan.png"/>
            </ImageView>
            <Label fx:id="modalTitle" text="Nouvel Utilisateur" 
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Remplissez les informations ci-dessous" 
                   style="-fx-font-size: 13px; -fx-text-fill: #9CA3AF;"/>
        </VBox>
        
        <VBox spacing="18.0" style="-fx-padding: 10 35 30 35;">

            <!-- Photo de profil moderne -->
            <HBox alignment="CENTER" spacing="20.0">
                <StackPane style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #667eea, #f093fb); -fx-background-radius: 50; -fx-padding: 3;">
                    <StackPane fx:id="profileImageContainer" 
                               style="-fx-background-color: #1a1a2e; -fx-background-radius: 47; -fx-min-width: 90; -fx-min-height: 90; -fx-max-width: 90; -fx-max-height: 90;">
                        <Label fx:id="lblProfileIcon" text="&#x1f464;" style="-fx-font-size: 40px;"/>
                    </StackPane>
                </StackPane>
                <VBox spacing="8.0" alignment="CENTER_LEFT">
                    <Label text="Photo de profil" style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: white;"/>
                    <Button text="📷 Parcourir" onAction="#uploadImage" 
                            style="-fx-background-color: linear-gradient(from 0% 0% to 100% 0%, #667eea, #764ba2); -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: 600; -fx-padding: 8 20; -fx-background-radius: 20; -fx-cursor: hand;"/>
                </VBox>
            </HBox>

            <!-- Form Fields avec style moderne -->
            <VBox spacing="14.0">
                <!-- Row 1: Nom + Prénom -->
                <HBox spacing="12.0">
                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                        <Label text="NOM" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #667eea; -fx-letter-spacing: 1;"/>
                        <TextField fx:id="tfNom" promptText="Votre nom" 
                                   style="-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 10; -fx-border-color: rgba(102,126,234,0.3); -fx-border-radius: 10; -fx-padding: 12 14; -fx-font-size: 13px; -fx-text-fill: white; -fx-prompt-text-fill: #6B7280;"/>
                    </VBox>
                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                        <Label text="PRÉNOM" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #667eea; -fx-letter-spacing: 1;"/>
                        <TextField fx:id="tfPrenom" promptText="Votre prénom" 
                                   style="-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 10; -fx-border-color: rgba(102,126,234,0.3); -fx-border-radius: 10; -fx-padding: 12 14; -fx-font-size: 13px; -fx-text-fill: white; -fx-prompt-text-fill: #6B7280;"/>
                    </VBox>
                </HBox>

                <!-- Email -->
                <VBox spacing="5.0">
                    <Label text="📧 EMAIL" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #667eea; -fx-letter-spacing: 1;"/>
                    <TextField fx:id="tfEmail" promptText="exemple@gmail.com" 
                               style="-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 10; -fx-border-color: rgba(102,126,234,0.3); -fx-border-radius: 10; -fx-padding: 12 14; -fx-font-size: 13px; -fx-text-fill: white; -fx-prompt-text-fill: #6B7280;"/>
                </VBox>

                <!-- Mot de passe -->
                <VBox spacing="5.0">
                    <Label text="🔐 MOT DE PASSE" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #667eea; -fx-letter-spacing: 1;"/>
                    <PasswordField fx:id="tfPassword" promptText="••••••••" 
                                   style="-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 10; -fx-border-color: rgba(102,126,234,0.3); -fx-border-radius: 10; -fx-padding: 12 14; -fx-font-size: 13px; -fx-text-fill: white; -fx-prompt-text-fill: #6B7280;"/>
                </VBox>

                <!-- Rôle -->
                <VBox spacing="5.0">
                    <Label text="👑 RÔLE" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #667eea; -fx-letter-spacing: 1;"/>
                    <ComboBox fx:id="cbRole" promptText="Sélectionnez un rôle" prefWidth="410.0"
                              style="-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 10; -fx-border-color: rgba(102,126,234,0.3); -fx-border-radius: 10; -fx-padding: 8 10; -fx-font-size: 13px;"/>
                </VBox>
            </VBox>

            <!-- Action Buttons -->
            <HBox spacing="12.0" alignment="CENTER" style="-fx-padding: 15 0 0 0;">
                <Button text="Annuler" onAction="#closeModal" 
                        style="-fx-background-color: transparent; -fx-text-fill: #9CA3AF; -fx-font-size: 14px; -fx-font-weight: 600; -fx-padding: 14 30; -fx-background-radius: 12; -fx-border-color: rgba(156,163,175,0.3); -fx-border-radius: 12; -fx-cursor: hand;"/>
                <Button fx:id="btnSave" text="✨ Enregistrer" onAction="#saveUser" 
                        style="-fx-background-color: linear-gradient(from 0% 0% to 100% 0%, #667eea, #f093fb); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 14 40; -fx-background-radius: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(102,126,234,0.4), 15, 0, 0, 5);"/>
            </HBox>

            <!-- Message Label -->
            <Label fx:id="lblModalMessage" style="-fx-font-size: 12px; -fx-text-alignment: center; -fx-text-fill: #f87171;" alignment="CENTER"/>
        </VBox>
    </VBox>
</StackPane>
        
<!-- MODAL CONFIRMATION SUPPRESSION -->
<StackPane fx:id="deleteModalOverlay" 
           visible="false" 
           managed="false"
           alignment="CENTER"
           style="-fx-background-color: rgba(0, 0, 0, 0.6);">
            <VBox fx:id="deleteModalContent" 
                  spacing="20.0" 
                  alignment="CENTER"
                  StackPane.alignment="CENTER"
                  style="-fx-background-color: white; -fx-background-radius: 20px; -fx-padding: 40px; -fx-max-width: 480px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 30, 0, 0, 10);">
                
                <!-- Icône d'avertissement animée -->
                <StackPane style="-fx-background-color: #FEE2E2; -fx-background-radius: 60px; -fx-pref-width: 120px; -fx-pref-height: 120px;">
                    <Label fx:id="lblDeleteIcon" text="⚠️" style="-fx-font-size: 60px;"/>
                </StackPane>
                
                <!-- Titre -->
                <Label text="Confirmation de suppression" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                
                <!-- Détails utilisateur -->
                <VBox spacing="8" alignment="CENTER" style="-fx-background-color: #F9FAFB; -fx-background-radius: 12px; -fx-padding: 20px;">
                    <Label text="Voulez-vous vraiment supprimer cet utilisateur ?" style="-fx-font-size: 14px; -fx-text-fill: #6B7280;"/>
                    <Label fx:id="lblDeleteUserInfo" style="-fx-font-size: 15px; -fx-font-weight: 600; -fx-text-fill: #374151; -fx-padding: 10 0 0 0;"/>
                </VBox>
                
                <!-- Message d'avertissement -->
                <HBox spacing="10" alignment="CENTER" style="-fx-background-color: #FEF2F2; -fx-background-radius: 10px; -fx-padding: 15px;">
                    <Label text="⚠️" style="-fx-font-size: 20px;"/>
                    <Label text="Cette action est irréversible !" style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #DC2626;"/>
                </HBox>
                
                <!-- Boutons d'action -->
                <HBox spacing="15" alignment="CENTER">
                    <Button text="❌ Annuler" 
                            onAction="#closeDeleteModal" 
                            style="-fx-background-color: #F3F4F6; -fx-text-fill: #374151; -fx-font-size: 14px; -fx-font-weight: 600; -fx-padding: 12px 30px; -fx-background-radius: 10px; -fx-cursor: hand;"/>
                    <Button fx:id="btnConfirmDelete" 
                            text="🗑️ Supprimer définitivement" 
                            onAction="#confirmDelete" 
                            style="-fx-background-color: #DC2626; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: 600; -fx-padding: 12px 30px; -fx-background-radius: 10px; -fx-cursor: hand;"/>
                </HBox>
            </VBox>
        </StackPane>

</StackPane>
