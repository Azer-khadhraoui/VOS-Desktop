<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.geometry.Insets?>

<BorderPane prefHeight="1024.0" prefWidth="1440.0" stylesheets="@AdministrationView.css"
            xmlns="http://javafx.com/javafx/17" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="controllers.DemandeCongeController">

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox fx:id="sidebar" styleClass="sidebar" prefWidth="80.0">
            <!-- Logo -->
            <VBox alignment="CENTER" styleClass="sidebar-logo">
                <ImageView fitHeight="55" fitWidth="55" preserveRatio="true">
                    <Image url="@img/VOSwhiteslogan.png"/>
                </ImageView>
            </VBox>

            <!-- Navigation Icons -->
            <VBox fx:id="navContainer" alignment="TOP_CENTER" spacing="20.0" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets top="30.0"/>
                </padding>

                <HBox fx:id="navStatistiques" styleClass="sidebar-nav-item" alignment="CENTER_LEFT" spacing="15.0">
                    <Label text="📊" styleClass="sidebar-nav-icon"/>
                    <Label text="Statistiques" styleClass="sidebar-nav-label"/>
                </HBox>
                
                <HBox fx:id="navOpportunites" styleClass="sidebar-nav-item" alignment="CENTER_LEFT" spacing="15.0">
                    <Label text="💼" styleClass="sidebar-nav-icon"/>
                    <Label text="Opportunités" styleClass="sidebar-nav-label"/>
                </HBox>
                
                <HBox fx:id="navServices" styleClass="sidebar-nav-item,sidebar-nav-item-active" alignment="CENTER_LEFT" spacing="15.0">
                    <Label text="🛠️" styleClass="sidebar-nav-icon"/>
                    <Label text="Services" styleClass="sidebar-nav-label"/>
                </HBox>
                
                <HBox fx:id="navAdministration" styleClass="sidebar-nav-item" alignment="CENTER_LEFT" spacing="15.0">
                    <Label text="👤" styleClass="sidebar-nav-icon"/>
                    <Label text="Administration" styleClass="sidebar-nav-label"/>
                </HBox>
                
                <HBox styleClass="sidebar-nav-item" alignment="CENTER_LEFT" spacing="15.0">
                    <Label text="⚙️" styleClass="sidebar-nav-icon"/>
                    <Label text="Paramètres" styleClass="sidebar-nav-label"/>
                </HBox>
                
                <HBox fx:id="navDeconnexion" styleClass="sidebar-nav-item,sidebar-nav-logout" alignment="CENTER_LEFT" spacing="15.0">
                    <Label text="⎋" styleClass="sidebar-nav-icon"/>
                    <Label text="Déconnexion" styleClass="sidebar-nav-label"/>
                </HBox>
            </VBox>
        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <VBox style="-fx-background-color: #f8f9fa;">
            <!-- TOP HEADER BAR -->
            <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="20.0">
                <padding>
                    <Insets top="20.0" right="30.0" bottom="20.0" left="30.0"/>
                </padding>

                <!-- Back Button -->
                <Button fx:id="btnBack" text="← Retour" styleClass="btn-back" style="-fx-font-size: 13px; -fx-padding: 8px 16px; -fx-background-color: #ecf0f1; -fx-border-color: #bdc3c7; -fx-border-radius: 5;"/>

                <!-- Spacer -->
                <Region HBox.hgrow="ALWAYS"/>

                <!-- User Profile -->
                <HBox spacing="15.0" alignment="CENTER">
                    <StackPane fx:id="userAvatarContainer" styleClass="user-avatar-container">
                        <Label fx:id="lblUserAvatar" text="👤" styleClass="user-avatar"/>
                    </StackPane>
                    <VBox alignment="CENTER_LEFT" spacing="2.0">
                        <Label fx:id="lblUserName" text="Mohamed Azer Khadhraoui" styleClass="user-name"/>
                        <Label fx:id="lblUserRole" text="CLIENT" styleClass="user-role"/>
                    </VBox>
                </HBox>
            </HBox>

            <!-- MAIN CONTENT AREA -->
            <ScrollPane fitToWidth="true" style="-fx-background-color: #f8f9fa; -fx-border-color: transparent;">
                <VBox spacing="30.0" style="-fx-padding: 40px;">

                    <!-- Page Header with gradient -->
                    <VBox spacing="15.0" style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #667eea, #764ba2); -fx-padding: 40px; -fx-border-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.15), 20, 0, 0, 5);">
                        <Label text="🏖️" style="-fx-font-size: 48px;"/>
                        <Label text="DEMANDE DE CONGÉ" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                        <Label text="Remplissez le formulaire et téléchargez votre demande en PDF" style="-fx-font-size: 14px; -fx-text-fill: rgba(255, 255, 255, 0.9);"/>
                    </VBox>

                    <!-- Main Form Card -->
                    <VBox spacing="25.0" style="-fx-background-color: white; -fx-padding: 40px; -fx-border-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.1), 15, 0, 0, 8);">
                        
                        <!-- Employee Info Section -->
                        <VBox spacing="15.0">
                            <Label text="👤 INFORMATIONS PERSONNELLES" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                            <HBox spacing="20.0">
                                <VBox spacing="6.0" HBox.hgrow="ALWAYS" style="-fx-background-color: #ecf0f1; -fx-padding: 15px; -fx-border-radius: 8;">
                                    <Label text="Nom complet" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
                                    <Label fx:id="lblFullName" text="-" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                                </VBox>
                                <VBox spacing="6.0" HBox.hgrow="ALWAYS" style="-fx-background-color: #ecf0f1; -fx-padding: 15px; -fx-border-radius: 8;">
                                    <Label text="Rôle" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
                                    <Label fx:id="lblRole" text="-" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                                </VBox>
                                <VBox spacing="6.0" HBox.hgrow="ALWAYS" style="-fx-background-color: #ecf0f1; -fx-padding: 15px; -fx-border-radius: 8;">
                                    <Label text="Email" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
                                    <Label fx:id="lblEmail" text="-" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <Separator style="-fx-padding: 10px 0;"/>

                        <!-- Request Details Section -->
                        <VBox spacing="15.0">
                            <Label text="📋 DÉTAILS DE LA DEMANDE" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                            
                            <!-- Row 1: Dates -->
                            <HBox spacing="20.0">
                                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                    <Label text="📅 Date de début" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #667eea;"/>
                                    <DatePicker fx:id="dpDateDebut" style="-fx-padding: 12px; -fx-font-size: 12px; -fx-background-color: white; -fx-border-color: #e0e6ff; -fx-border-radius: 8; -fx-border-width: 2;"/>
                                </VBox>
                                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                    <Label text="📅 Date de fin" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #667eea;"/>
                                    <DatePicker fx:id="dpDateFin" style="-fx-padding: 12px; -fx-font-size: 12px; -fx-background-color: white; -fx-border-color: #e0e6ff; -fx-border-radius: 8; -fx-border-width: 2;"/>
                                </VBox>
                            </HBox>

                            <!-- Row 2: Type and Duration -->
                            <HBox spacing="20.0">
                                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                    <Label text="🏷️ Type de congé" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #667eea;"/>
                                    <ComboBox fx:id="cbTypeCongé" style="-fx-padding: 12px; -fx-font-size: 12px; -fx-background-color: white; -fx-border-color: #e0e6ff; -fx-border-radius: 8; -fx-border-width: 2;" promptText="Sélectionnez un type"/>
                                </VBox>
                                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                    <Label text="📊 Nombre de jours" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #667eea;"/>
                                    <Spinner fx:id="spNombreJours" min="0" max="365" initialValue="1" style="-fx-padding: 12px; -fx-font-size: 12px; -fx-background-color: white; -fx-border-color: #e0e6ff; -fx-border-radius: 8; -fx-border-width: 2;"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <Separator style="-fx-padding: 10px 0;"/>

                        <!-- Comments Section -->
                        <VBox spacing="8.0">
                            <Label text="💬 Raison/Commentaires (optionnel)" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                            <HBox spacing="10.0">
                                <TextArea fx:id="taComments" wrapText="true" prefHeight="120.0" style="-fx-padding: 12px; -fx-font-size: 12px; -fx-control-inner-background: white; -fx-border-color: #ddd; -fx-border-radius: 8; -fx-border-width: 1;" HBox.hgrow="ALWAYS"/>
                                <VBox spacing="8.0" prefWidth="140.0">
                                    <Button fx:id="btnGenerateAI" text="🤖 Générer" style="-fx-padding: 12px 20px; -fx-font-size: 12px; -fx-background-color: #667eea; -fx-text-fill: white; -fx-border-radius: 8; -fx-cursor: hand;" prefWidth="140.0"/>
                                    <Button fx:id="btnCheckQuality" text="✓ Vérifier" style="-fx-padding: 12px 20px; -fx-font-size: 12px; -fx-background-color: #27ae60; -fx-text-fill: white; -fx-border-radius: 8; -fx-cursor: hand;" prefWidth="140.0"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <Separator style="-fx-padding: 10px 0;"/>

                        <!-- Confirmation -->
                        <VBox spacing="12.0" style="-fx-background-color: #fff3cd; -fx-padding: 15px; -fx-border-radius: 8; -fx-border-color: #ffc107; -fx-border-width: 2;">
                            <CheckBox fx:id="cbConfirm" text="✓ Je confirme cette demande de congé" style="-fx-font-size: 12px; -fx-font-weight: bold;"/>
                            <Label text="⚠️ Cette demande de congé sera documentée et envoyée à votre responsable." style="-fx-font-size: 11px; -fx-text-fill: #856404; -fx-wrap-text: true;"/>
                        </VBox>

                        <!-- Buttons -->
                        <HBox spacing="15.0" alignment="CENTER_RIGHT" style="-fx-padding: 20px 0 0 0;">
                            <Button fx:id="btnDownloadPDF" text="📥 Télécharger en PDF" style="-fx-font-size: 13px; -fx-padding: 14px 28px; -fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #667eea, #764ba2); -fx-text-fill: white; -fx-font-weight: bold; -fx-border-radius: 8; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(102, 126, 234, 0.4), 10, 0, 0, 3);"/>
                            <Button fx:id="btnCancel" text="✕ Annuler" style="-fx-font-size: 13px; -fx-padding: 14px 28px; -fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-border-radius: 8; -fx-cursor: hand;"/>
                        </HBox>

                        <!-- Status Message -->
                        <Label fx:id="lblMessage" text="" style="-fx-font-size: 12px; -fx-padding: 12px; -fx-text-alignment: center; -fx-wrap-text: true;"/>

                    </VBox>

                </VBox>
            </ScrollPane>
        </VBox>
    </center>

</BorderPane>
