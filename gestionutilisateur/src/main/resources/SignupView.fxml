<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.shape.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.SignupController"
            stylesheets="@styleUser.css"
            prefWidth="1440"
            prefHeight="1024">

    <!-- BACKGROUND -->
    <Pane prefWidth="1440"
          prefHeight="1024"
          styleClass="backgroundPane"/>

    <!-- FORMULAIRE -->
    <VBox spacing="10"
          prefWidth="360"
          layoutX="800"
          layoutY="80"
          alignment="TOP_LEFT"
          style="-fx-background-color: transparent;">

        <!-- TITRE -->
        <Label text="Bienvenue à VOS" styleClass="title"/>
        <Label text="Créez votre compte et commencez l’expérience"
               styleClass="subtitle"/>

        <!-- NOM -->
        <Label text="Nom" styleClass="fieldLabel"/>
        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="inputBox">
            <Label text="👤"/>
            <TextField fx:id="tfNom"
                       promptText="Votre nom"
                       styleClass="inputField"/>
        </HBox>

        <!-- PRENOM -->
        <Label text="Prénom" styleClass="fieldLabel"/>
        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="inputBox">
            <Label text="👤"/>
            <TextField fx:id="tfPrenom"
                       promptText="Votre prénom"
                       styleClass="inputField"/>
        </HBox>

        <!-- EMAIL -->
        <Label text="Adresse e-mail" styleClass="fieldLabel"/>
        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="inputBox">
            <Label text="📧"/>
            <TextField fx:id="tfEmail"
                       promptText="exemple@gmail.com"
                       styleClass="inputField"/>
        </HBox>

        <!-- PASSWORD -->
        <Label text="Mot de passe" styleClass="fieldLabel"/>
        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="inputBox">
            <Label text="🔒"/>
            <PasswordField fx:id="tfPassword"
                           promptText="••••••••"
                           styleClass="inputField"/>
        </HBox>
        
        <!-- PASSWORD STRENGTH BAR -->
        <VBox spacing="4">
            <ProgressBar fx:id="passwordStrengthBar" prefWidth="300" style="-fx-padding: 0; -fx-min-height: 6px;" progress="0"/>
            <Label fx:id="passwordStrengthLabel" text="Aucun mot de passe" style="-fx-font-size: 10px; -fx-text-fill: #999;"/>
        </VBox>
        
        <!-- CONFIRM PASSWORD -->
        <Label text="Confirmer mot de passe" styleClass="fieldLabel"/>
        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="inputBox">
            <Label text="🔒"/>
            <PasswordField fx:id="tfConfirmPassword"
                           promptText="••••••••"
                           styleClass="inputField"/>
        </HBox>
        <Label fx:id="lblPasswordMatch" style="-fx-font-size: 10px; -fx-text-fill: #e74c3c;"/>

        <!-- BOUTONS -->
        <VBox spacing="15"
              alignment="CENTER"
              style="-fx-padding: 10 0 0 0;">

            <!-- UPLOAD PHOTO AVEC APERÇU -->
            <HBox spacing="15" alignment="CENTER">
                <Button text="📷 Ajouter une photo de profil"
                        onAction="#uploadImage"
                        styleClass="btnUpload"
                        prefWidth="200"/>

                <!-- PHOTO DE PROFIL -->
                <StackPane fx:id="profileImageContainer" alignment="CENTER" 
                           visible="false" managed="false">
                    <StackPane style="-fx-background-color: white; -fx-background-radius: 65px; 
                                      -fx-effect: dropshadow(gaussian, rgba(59,130,246,0.3), 12, 0, 0, 3);">
                        <ImageView fx:id="imgProfile" fitWidth="110" fitHeight="110" preserveRatio="true">
                            <clip>
                                <Circle centerX="55" centerY="55" radius="55"/>
                            </clip>
                        </ImageView>
                    </StackPane>
                </StackPane>
            </HBox>

            <Button text="✨ S'inscrire"
                    onAction="#signup"
                    styleClass="btnSignupGlow"/>
        </VBox>

        <!-- LIEN RETOUR SIGNIN -->
        <HBox spacing="6" alignment="CENTER_LEFT" styleClass="hintRow">
            <Label text="Vous avez déjà un compte ?" styleClass="hintText"/>
            <Hyperlink text="Se connecter"
                       onAction="#goToSignin"
                       styleClass="link"/>
        </HBox>

        <Label fx:id="lblMessage" styleClass="message"/>


    </VBox>

</AnchorPane>
