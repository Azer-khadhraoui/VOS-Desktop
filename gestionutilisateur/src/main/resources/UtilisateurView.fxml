<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.UtilisateurController">

    <top>
        <Label text="Gestion des Utilisateurs"
               style="-fx-font-size: 22px; -fx-font-weight: bold;"
               BorderPane.alignment="CENTER"/>
    </top>

    <left>
        <VBox spacing="10">

            <TextField fx:id="tfEmail" promptText="Email"/>
            <PasswordField fx:id="tfPassword" promptText="Mot de passe"/>
            <TextField fx:id="tfNom" promptText="Nom"/>
            <TextField fx:id="tfPrenom" promptText="Prenom"/>

            <HBox spacing="10">
                <Button text="Ajouter" onAction="#ajouterUtilisateur"/>
                <Button text="Modifier" onAction="#modifierUtilisateur"/>
                <Button text="Supprimer" onAction="#supprimerUtilisateur"/>
            </HBox>

        </VBox>
    </left>

    <center>
        <TableView fx:id="tableUsers">

            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                <TableColumn fx:id="colEmail" text="Email" prefWidth="150"/>
                <TableColumn fx:id="colRole" text="Role" prefWidth="120"/>
                <TableColumn fx:id="colNom" text="Nom" prefWidth="100"/>
                <TableColumn fx:id="colPrenom" text="Prenom" prefWidth="100"/>
            </columns>

        </TableView>
    </center>

</BorderPane>
