<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<StackPane prefHeight="750.0" prefWidth="900.0" stylesheets="@../styles/modern.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.EvaluationGrilleFormController">

    <VBox alignment="CENTER" maxWidth="870.0" minWidth="870.0" spacing="0.0"
          style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #1a1a2e, #16213e); -fx-background-radius: 28; -fx-effect: dropshadow(gaussian, rgba(102, 126, 234, 0.5), 60, 0, 0, 0);">

        <!-- Header -->
        <VBox alignment="CENTER" spacing="8.0"
              style="-fx-background-color: transparent; -fx-padding: 30 30 20 30;">
            <Label text="⭐ Grille d'Évaluation d'Entretien"
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label fx:id="entretienInfoLabel" text="Entretien RH - Date: 18/02/2026"
                   style="-fx-font-size: 13px; -fx-text-fill: #9CA3AF;"/>
        </VBox>

        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
            <VBox spacing="20.0" style="-fx-padding: 10 35 30 35;">

                <!-- Questions Exemples -->
                <VBox spacing="10.0" style="-fx-background-color: rgba(102, 126, 234, 0.1); -fx-background-radius: 15; -fx-padding: 20; -fx-border-color: rgba(102, 126, 234, 0.3); -fx-border-radius: 15; -fx-border-width: 1;">
                    <!-- Header avec bouton IA -->
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <Label text="📝 Questions pour l'Entretien"
                               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #667eea;" HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnGenererIA"
                                text="🤖 Générer avec IA"
                                onAction="#handleGenererQuestions"
                                style="-fx-background-color: linear-gradient(135deg, #667eea, #764ba2);
                                       -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px;
                                       -fx-background-radius: 20; -fx-padding: 8 18; -fx-cursor: hand;"/>
                    </HBox>
                    <!-- Indicateur de chargement -->
                    <HBox fx:id="loadingBox" visible="false" managed="false" alignment="CENTER_LEFT" spacing="10.0">
                        <ProgressIndicator prefWidth="20.0" prefHeight="20.0"
                                           style="-fx-progress-color: #667eea;"/>
                        <Label text="L'IA génère vos questions personnalisées..."
                               style="-fx-text-fill: #667eea; -fx-font-size: 12px; -fx-font-style: italic;"/>
                    </HBox>
                    <!-- Questions -->
                    <VBox fx:id="questionsExemplesBox" spacing="8.0" style="-fx-padding: 10 0 0 0;">
                        <!-- Questions ajoutées dynamiquement -->
                    </VBox>
                </VBox>

                <!-- Grille d'Évaluation -->
                <VBox spacing="15.0" style="-fx-background-color: rgba(16, 185, 129, 0.05); -fx-background-radius: 15; -fx-padding: 20; -fx-border-color: rgba(16, 185, 129, 0.3); -fx-border-radius: 15; -fx-border-width: 1;">
                    <Label text="📊 Grille d'Évaluation (Notez de 1 à 5)"
                           style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #10b981;"/>

                    <!-- Compétences Techniques -->
                    <HBox spacing="15.0" alignment="CENTER_LEFT">
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <Label text="💻 Compétences Techniques" style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: white;"/>
                            <Label text="Maîtrise des technologies et outils du poste" style="-fx-font-size: 11px; -fx-text-fill: #9CA3AF;"/>
                        </VBox>
                        <HBox spacing="8.0" alignment="CENTER">
                            <ToggleButton fx:id="techBtn1" text="1" styleClass="rating-btn" userData="1"/>
                            <ToggleButton fx:id="techBtn2" text="2" styleClass="rating-btn" userData="2"/>
                            <ToggleButton fx:id="techBtn3" text="3" styleClass="rating-btn" userData="3"/>
                            <ToggleButton fx:id="techBtn4" text="4" styleClass="rating-btn" userData="4"/>
                            <ToggleButton fx:id="techBtn5" text="5" styleClass="rating-btn" userData="5"/>
                        </HBox>
                    </HBox>

                    <Separator style="-fx-background-color: rgba(255,255,255,0.1);"/>

                    <!-- Compétences Comportementales -->
                    <HBox spacing="15.0" alignment="CENTER_LEFT">
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <Label text="🎯 Compétences Comportementales" style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: white;"/>
                            <Label text="Savoir-être, adaptabilité, travail d'équipe" style="-fx-font-size: 11px; -fx-text-fill: #9CA3AF;"/>
                        </VBox>
                        <HBox spacing="8.0" alignment="CENTER">
                            <ToggleButton fx:id="compBtn1" text="1" styleClass="rating-btn" userData="1"/>
                            <ToggleButton fx:id="compBtn2" text="2" styleClass="rating-btn" userData="2"/>
                            <ToggleButton fx:id="compBtn3" text="3" styleClass="rating-btn" userData="3"/>
                            <ToggleButton fx:id="compBtn4" text="4" styleClass="rating-btn" userData="4"/>
                            <ToggleButton fx:id="compBtn5" text="5" styleClass="rating-btn" userData="5"/>
                        </HBox>
                    </HBox>

                    <Separator style="-fx-background-color: rgba(255,255,255,0.1);"/>

                    <!-- Communication -->
                    <HBox spacing="15.0" alignment="CENTER_LEFT">
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <Label text="💬 Communication" style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: white;"/>
                            <Label text="Expression orale, clarté, écoute active" style="-fx-font-size: 11px; -fx-text-fill: #9CA3AF;"/>
                        </VBox>
                        <HBox spacing="8.0" alignment="CENTER">
                            <ToggleButton fx:id="commBtn1" text="1" styleClass="rating-btn" userData="1"/>
                            <ToggleButton fx:id="commBtn2" text="2" styleClass="rating-btn" userData="2"/>
                            <ToggleButton fx:id="commBtn3" text="3" styleClass="rating-btn" userData="3"/>
                            <ToggleButton fx:id="commBtn4" text="4" styleClass="rating-btn" userData="4"/>
                            <ToggleButton fx:id="commBtn5" text="5" styleClass="rating-btn" userData="5"/>
                        </HBox>
                    </HBox>

                    <Separator style="-fx-background-color: rgba(255,255,255,0.1);"/>

                    <!-- Motivation -->
                    <HBox spacing="15.0" alignment="CENTER_LEFT">
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <Label text="🔥 Motivation" style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: white;"/>
                            <Label text="Intérêt pour le poste et l'entreprise" style="-fx-font-size: 11px; -fx-text-fill: #9CA3AF;"/>
                        </VBox>
                        <HBox spacing="8.0" alignment="CENTER">
                            <ToggleButton fx:id="motivBtn1" text="1" styleClass="rating-btn" userData="1"/>
                            <ToggleButton fx:id="motivBtn2" text="2" styleClass="rating-btn" userData="2"/>
                            <ToggleButton fx:id="motivBtn3" text="3" styleClass="rating-btn" userData="3"/>
                            <ToggleButton fx:id="motivBtn4" text="4" styleClass="rating-btn" userData="4"/>
                            <ToggleButton fx:id="motivBtn5" text="5" styleClass="rating-btn" userData="5"/>
                        </HBox>
                    </HBox>

                    <Separator style="-fx-background-color: rgba(255,255,255,0.1);"/>

                    <!-- Expérience -->
                    <HBox spacing="15.0" alignment="CENTER_LEFT">
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <Label text="📂 Expérience Professionnelle" style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: white;"/>
                            <Label text="Parcours et réalisations pertinentes" style="-fx-font-size: 11px; -fx-text-fill: #9CA3AF;"/>
                        </VBox>
                        <HBox spacing="8.0" alignment="CENTER">
                            <ToggleButton fx:id="expBtn1" text="1" styleClass="rating-btn" userData="1"/>
                            <ToggleButton fx:id="expBtn2" text="2" styleClass="rating-btn" userData="2"/>
                            <ToggleButton fx:id="expBtn3" text="3" styleClass="rating-btn" userData="3"/>
                            <ToggleButton fx:id="expBtn4" text="4" styleClass="rating-btn" userData="4"/>
                            <ToggleButton fx:id="expBtn5" text="5" styleClass="rating-btn" userData="5"/>
                        </HBox>
                    </HBox>
                </VBox>

                <!-- Score Test et Note Globale -->
                <HBox spacing="15.0">
                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                        <Label text="📊 SCORE DU TEST (%)" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #667eea;"/>
                        <TextField fx:id="scoreField" promptText="Ex: 85.5"
                                   style="-fx-background-color: rgba(255,255,255,0.08); -fx-text-fill: white; -fx-prompt-text-fill: #6B7280; -fx-border-color: rgba(255,255,255,0.2); -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 12 15; -fx-font-size: 14px;"/>
                        <Label fx:id="scoreError" visible="false" managed="false"
                               style="-fx-text-fill: #F87171; -fx-font-size: 11px; -fx-font-weight: 600; -fx-padding: 2 0 0 4;"/>
                    </VBox>
                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                        <Label text="⭐ NOTE GLOBALE (1-5)" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #667eea;"/>
                        <TextField fx:id="noteField" promptText="Auto-calculé"
                                   style="-fx-background-color: rgba(255,255,255,0.08); -fx-text-fill: white; -fx-prompt-text-fill: #6B7280; -fx-border-color: rgba(255,255,255,0.2); -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 12 15; -fx-font-size: 14px;"/>
                        <Label fx:id="noteError" visible="false" managed="false"
                               style="-fx-text-fill: #F87171; -fx-font-size: 11px; -fx-font-weight: 600; -fx-padding: 2 0 0 4;"/>
                    </VBox>
                </HBox>

                <!-- Commentaire -->
                <VBox spacing="4.0">
                    <Label text="💬 COMMENTAIRE" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #667eea;"/>
                    <TextArea fx:id="commentaireField" promptText="Bilan général de l'entretien (minimum 10 caractères)..."
                              prefRowCount="4"
                              style="-fx-background-color: #2D3748; -fx-text-fill: white; -fx-prompt-text-fill: #6B7280; -fx-border-color: rgba(255,255,255,0.2); -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 12 15; -fx-font-size: 14px; -fx-control-inner-background: #2D3748;"/>
                    <Label fx:id="commentaireError" visible="false" managed="false"
                           style="-fx-text-fill: #F87171; -fx-font-size: 11px; -fx-font-weight: 600; -fx-padding: 2 0 0 4;"/>
                    <Label fx:id="commentaireCount" text="0 / 500 caractères"
                           style="-fx-text-fill: #6B7280; -fx-font-size: 11px; -fx-padding: 0 0 0 4;"/>
                </VBox>

                <!-- Décision -->
                <VBox spacing="4.0">
                    <Label text="✅ DÉCISION FINALE" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #667eea;"/>
                    <ComboBox fx:id="decisionField" promptText="Sélectionnez la décision" maxWidth="Infinity"
                              style="-fx-background-color: rgba(255,255,255,0.08); -fx-text-fill: white; -fx-border-color: rgba(255,255,255,0.2); -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 5 10; -fx-font-size: 14px;"/>
                    <Label fx:id="decisionError" visible="false" managed="false"
                           style="-fx-text-fill: #F87171; -fx-font-size: 11px; -fx-font-weight: 600; -fx-padding: 2 0 0 4;"/>
                </VBox>

                <!-- Sélection de l'Entretien (visible uniquement en mode Ajout) -->
                <VBox fx:id="entretienSelectBox" spacing="4.0">
                    <Label text="🎯 ENTRETIEN À ÉVALUER" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #667eea;"/>
                    <ComboBox fx:id="entretienComboField" promptText="Sélectionnez un entretien terminé..." maxWidth="Infinity"
                              style="-fx-background-color: #2D3748; -fx-text-fill: white;
                                     -fx-border-color: rgba(255,255,255,0.2); -fx-border-radius: 10;
                                     -fx-background-radius: 10; -fx-padding: 5 10; -fx-font-size: 13px;"/>
                    <Label fx:id="entretienSelectError" visible="false" managed="false"
                           style="-fx-text-fill: #F87171; -fx-font-size: 11px; -fx-font-weight: 600; -fx-padding: 2 0 0 4;"/>
                </VBox>

                <!-- Hidden field for ID Entretien -->
                <TextField fx:id="idEntretienField" visible="false" managed="false"/>

                <!-- Buttons -->
                <HBox spacing="12.0" alignment="CENTER" style="-fx-padding: 15 0 0 0;">
                    <Button text="Annuler" onAction="#handleCancel"
                            style="-fx-background-color: transparent; -fx-text-fill: #9CA3AF; -fx-font-size: 14px; -fx-font-weight: 600; -fx-padding: 14 30; -fx-background-radius: 12; -fx-border-color: rgba(156,163,175,0.3); -fx-border-radius: 12; -fx-cursor: hand;"/>
                    <Button text="✨ Enregistrer l'Évaluation" onAction="#handleSave"
                            style="-fx-background-color: linear-gradient(from 0% 0% to 100% 0%, #667eea, #f093fb); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 14 40; -fx-background-radius: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(102,126,234,0.4), 15, 0, 0, 5);"/>
                </HBox>
            </VBox>
        </ScrollPane>
    </VBox>
</StackPane>
