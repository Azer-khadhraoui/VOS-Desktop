<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<StackPane prefHeight="650.0" prefWidth="550.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.EntretienFormController">

    <VBox alignment="CENTER" maxWidth="520.0" minWidth="520.0" spacing="0.0"
          style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #1a1a2e, #16213e); -fx-background-radius: 28; -fx-effect: dropshadow(gaussian, rgba(102, 126, 234, 0.5), 60, 0, 0, 0);">

        <!-- Header avec logo animé -->
        <VBox alignment="CENTER" spacing="8.0"
              style="-fx-background-color: transparent; -fx-padding: 30 30 20 30;">
            <ImageView fitHeight="80.0" fitWidth="180.0" preserveRatio="true">
                <Image url="@../images/vos-logo.png"/>
            </ImageView>
            <Label text="📋 Modifier l'entretien"
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Remplissez les informations ci-dessous"
                   style="-fx-font-size: 13px; -fx-text-fill: #9CA3AF;"/>
        </VBox>

        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox spacing="18.0" style="-fx-padding: 10 35 30 35;">

                <!-- Form Fields avec style moderne -->
                <VBox spacing="14.0">
                    <!-- Date -->
                    <VBox spacing="5.0">
                        <Label text="📅 DATE" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #667eea; -fx-letter-spacing: 1;"/>
                        <DatePicker fx:id="dateField" prefWidth="450.0"
                                    style="-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 10; -fx-border-color: rgba(102,126,234,0.3); -fx-border-radius: 10; -fx-padding: 12 14;"/>
                    </VBox>

                    <!-- Heure -->
                    <VBox spacing="5.0">
                        <Label text="🕐 HEURE (HH:MM:SS)" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #667eea; -fx-letter-spacing: 1;"/>
                        <TextField fx:id="heureField" promptText="10:00:00"
                                   style="-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 10; -fx-border-color: rgba(102,126,234,0.3); -fx-border-radius: 10; -fx-padding: 12 14; -fx-font-size: 13px; -fx-text-fill: white; -fx-prompt-text-fill: #6B7280;"/>
                    </VBox>

                    <!-- Type -->
                    <VBox spacing="5.0">
                        <Label text="💼 TYPE" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #667eea; -fx-letter-spacing: 1;"/>
                        <ComboBox fx:id="typeField" promptText="Sélectionnez le type" prefWidth="450.0"
                                  style="-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 10; -fx-border-color: rgba(102,126,234,0.3); -fx-border-radius: 10; -fx-padding: 8 10; -fx-font-size: 13px;"/>
                    </VBox>

                    <!-- Statut -->
                    <VBox spacing="5.0">
                        <Label text="📊 STATUT" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #667eea; -fx-letter-spacing: 1;"/>
                        <ComboBox fx:id="statutField" promptText="Sélectionnez le statut" prefWidth="450.0"
                                  style="-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 10; -fx-border-color: rgba(102,126,234,0.3); -fx-border-radius: 10; -fx-padding: 8 10; -fx-font-size: 13px;"/>
                    </VBox>

                    <!-- Lieu -->
                    <VBox spacing="5.0">
                        <Label text="📍 LIEU" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #667eea; -fx-letter-spacing: 1;"/>
                        <TextField fx:id="lieuField" promptText="Bureau RH - Salle A"
                                   style="-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 10; -fx-border-color: rgba(102,126,234,0.3); -fx-border-radius: 10; -fx-padding: 12 14; -fx-font-size: 13px; -fx-text-fill: white; -fx-prompt-text-fill: #6B7280;"/>
                    </VBox>

                    <!-- Type de test -->
                    <VBox spacing="5.0">
                        <Label text="📝 TYPE DE TEST" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #667eea; -fx-letter-spacing: 1;"/>
                        <TextField fx:id="typeTestField" promptText="Test de personnalité"
                                   style="-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 10; -fx-border-color: rgba(102,126,234,0.3); -fx-border-radius: 10; -fx-padding: 12 14; -fx-font-size: 13px; -fx-text-fill: white; -fx-prompt-text-fill: #6B7280;"/>
                    </VBox>

                    <!-- Row: ID Candidature + ID Utilisateur -->
                    <HBox spacing="12.0">
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <Label text="🎫 ID CANDIDATURE" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #667eea; -fx-letter-spacing: 1;"/>
                            <TextField fx:id="idCandidatureField" promptText="1"
                                       style="-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 10; -fx-border-color: rgba(102,126,234,0.3); -fx-border-radius: 10; -fx-padding: 12 14; -fx-font-size: 13px; -fx-text-fill: white; -fx-prompt-text-fill: #6B7280;"/>
                        </VBox>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <Label text="👤 ID UTILISATEUR" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #667eea; -fx-letter-spacing: 1;"/>
                            <TextField fx:id="idUtilisateurField" promptText="1"
                                       style="-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 10; -fx-border-color: rgba(102,126,234,0.3); -fx-border-radius: 10; -fx-padding: 12 14; -fx-font-size: 13px; -fx-text-fill: white; -fx-prompt-text-fill: #6B7280;"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Action Buttons -->
                <HBox spacing="12.0" alignment="CENTER" style="-fx-padding: 15 0 0 0;">
                    <Button text="Annuler" onAction="#handleCancel"
                            style="-fx-background-color: transparent; -fx-text-fill: #9CA3AF; -fx-font-size: 14px; -fx-font-weight: 600; -fx-padding: 14 30; -fx-background-radius: 12; -fx-border-color: rgba(156,163,175,0.3); -fx-border-radius: 12; -fx-cursor: hand;"/>
                    <Button text="✨ Enregistrer" onAction="#handleSave"
                            style="-fx-background-color: linear-gradient(from 0% 0% to 100% 0%, #667eea, #f093fb); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 14 40; -fx-background-radius: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(102,126,234,0.4), 15, 0, 0, 5);"/>
                </HBox>
            </VBox>
        </ScrollPane>
    </VBox>
</StackPane>