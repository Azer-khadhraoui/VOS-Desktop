<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.lang.String?>
<?import javafx.collections.FXCollections?>

<BorderPane prefHeight="800.0" prefWidth="1000.0"
            stylesheets="@../../css/modernRecrutement.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="vos.gestionCandidat.controllers.admin.FormCandidatureAdminController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: white; -fx-padding: 20 30; -fx-border-color: #e5e7eb; -fx-border-width: 0 0 1 0;">
            <Button text="← Retour" onAction="#annuler"
                    style="-fx-background-color: transparent; -fx-text-fill: #2563eb; -fx-font-size: 14px; -fx-font-weight: 600; -fx-cursor: hand; -fx-padding: 0;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="formTitle" text="Nouvelle Candidature"
                   style="-fx-font-size: 18px; -fx-font-weight: 700; -fx-text-fill: #111827;"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #f8fafc; -fx-border-color: transparent;">
            <VBox spacing="24" style="-fx-background-color: #f8fafc; -fx-padding: 35 40 50 40;">

                <VBox spacing="12">
                    <Label text="Informations générales"
                           style="-fx-font-size: 16px; -fx-font-weight: 700; -fx-text-fill: #111827;"/>
                    
                    <VBox spacing="0" style="-fx-background-color: white; -fx-padding: 24; -fx-background-radius: 12; -fx-border-color: #e5e7eb; -fx-border-width: 1;">
                        <GridPane hgap="20" vgap="16">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                            </columnConstraints>

                            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="Date de candidature *"
                                       style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #374151;"/>
                                <DatePicker fx:id="dateCandidature"
                                            style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #cbd5e1; -fx-pref-height: 40;"
                                            maxWidth="Infinity"/>
                            </VBox>

                            <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="Statut *"
                                       style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #374151;"/>
                                <ComboBox fx:id="statut" maxWidth="Infinity"
                                          style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #cbd5e1; -fx-pref-height: 40;">
                                    <items>
                                        <FXCollections fx:factory="observableArrayList">
                                            <String fx:value="En attente"/>
                                            <String fx:value="Acceptée"/>
                                            <String fx:value="Refusée"/>
                                            <String fx:value="En cours"/>
                                        </FXCollections>
                                    </items>
                                </ComboBox>
                            </VBox>

                            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <Label text="ID Candidat *"
                                       style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #374151;"/>
                                <TextField fx:id="idUtilisateur" promptText="Ex: 12"
                                           style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #cbd5e1; -fx-background-color: white; -fx-pref-height: 40; -fx-padding: 0 12;"/>
                            </VBox>

                            <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                <Label text="ID Offre *"
                                       style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #374151;"/>
                                <TextField fx:id="idOffre" promptText="Ex: 5"
                                           style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #cbd5e1; -fx-background-color: white; -fx-pref-height: 40; -fx-padding: 0 12;"/>
                            </VBox>
                        </GridPane>
                    </VBox>
                </VBox>

                <VBox spacing="12">
                    <Label text="Expérience professionnelle"
                           style="-fx-font-size: 16px; -fx-font-weight: 700; -fx-text-fill: #111827;"/>
                    
                    <VBox spacing="0" style="-fx-background-color: white; -fx-padding: 24; -fx-background-radius: 12; -fx-border-color: #e5e7eb; -fx-border-width: 1;">
                        <GridPane hgap="20" vgap="16">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                            </columnConstraints>

                            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="Niveau d'expérience"
                                       style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #374151;"/>
                                <ComboBox fx:id="niveauExperience" maxWidth="Infinity"
                                          style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #cbd5e1; -fx-pref-height: 40;">
                                    <items>
                                        <FXCollections fx:factory="observableArrayList">
                                            <String fx:value="Débutant"/>
                                            <String fx:value="Junior"/>
                                            <String fx:value="Intermédiaire"/>
                                            <String fx:value="Senior"/>
                                            <String fx:value="Expert"/>
                                        </FXCollections>
                                    </items>
                                </ComboBox>
                            </VBox>

                            <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="Années d'expérience"
                                       style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #374151;"/>
                                <Spinner fx:id="anneesExperience" min="0" max="50" initialValue="0"
                                         editable="true"
                                         style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #cbd5e1; -fx-background-color: white; -fx-pref-height: 40;"
                                         maxWidth="Infinity"/>
                            </VBox>

                            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <Label text="Domaine d'expérience"
                                       style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #374151;"/>
                                <ComboBox fx:id="domaineExperience" maxWidth="Infinity"
                                          style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #cbd5e1; -fx-pref-height: 40;">
                                    <items>
                                        <FXCollections fx:factory="observableArrayList">
                                            <String fx:value="Développement Web"/>
                                            <String fx:value="Développement Mobile"/>
                                            <String fx:value="Data Science"/>
                                            <String fx:value="DevOps"/>
                                            <String fx:value="Cybersécurité"/>
                                            <String fx:value="Machine Learning"/>
                                            <String fx:value="Cloud Architecture"/>
                                            <String fx:value="Marketing Digital"/>
                                            <String fx:value="Autre"/>
                                        </FXCollections>
                                    </items>
                                </ComboBox>
                            </VBox>

                            <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                <Label text="Dernier poste occupé"
                                       style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #374151;"/>
                                <ComboBox fx:id="dernierPoste" maxWidth="Infinity"
                                          style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #cbd5e1; -fx-pref-height: 40;">
                                    <items>
                                        <FXCollections fx:factory="observableArrayList">
                                            <String fx:value="Développeur Backend"/>
                                            <String fx:value="Développeur Frontend"/>
                                            <String fx:value="Développeur Full-Stack"/>
                                            <String fx:value="Développeur Mobile"/>
                                            <String fx:value="Data Scientist"/>
                                            <String fx:value="DevOps Engineer"/>
                                            <String fx:value="Security Engineer"/>
                                            <String fx:value="Product Manager"/>
                                            <String fx:value="Scrum Master"/>
                                            <String fx:value="Autre"/>
                                        </FXCollections>
                                    </items>
                                </ComboBox>
                            </VBox>
                        </GridPane>
                    </VBox>
                </VBox>

                <VBox spacing="12">
                    <Label text="Documents"
                           style="-fx-font-size: 16px; -fx-font-weight: 700; -fx-text-fill: #111827;"/>
                    
                    <VBox spacing="0" style="-fx-background-color: white; -fx-padding: 24; -fx-background-radius: 12; -fx-border-color: #e5e7eb; -fx-border-width: 1;">
                        <GridPane hgap="20" vgap="16">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                            </columnConstraints>

                            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="CV (chemin / URL)"
                                       style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #374151;"/>
                                <HBox spacing="8">
                                    <TextField fx:id="cv" promptText="Chemin vers le CV..."
                                               style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #cbd5e1; -fx-background-color: white; -fx-pref-height: 40; -fx-padding: 0 12;"
                                               HBox.hgrow="ALWAYS"/>
                                    <Button text="📎" onAction="#parcourirCv"
                                            style="-fx-background-color: #eef2ff; -fx-text-fill: #2563eb; -fx-background-radius: 8; -fx-pref-height: 40; -fx-pref-width: 40; -fx-cursor: hand; -fx-font-size: 16px;"/>
                                </HBox>
                            </VBox>

                            <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="Lettre de motivation (chemin / URL)"
                                       style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #374151;"/>
                                <HBox spacing="8">
                                    <TextField fx:id="lettreMotivation" promptText="Chemin vers la lettre..."
                                               style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #cbd5e1; -fx-background-color: white; -fx-pref-height: 40; -fx-padding: 0 12;"
                                               HBox.hgrow="ALWAYS"/>
                                    <Button text="📎" onAction="#parcourirLettre"
                                            style="-fx-background-color: #eef2ff; -fx-text-fill: #2563eb; -fx-background-radius: 8; -fx-pref-height: 40; -fx-pref-width: 40; -fx-cursor: hand; -fx-font-size: 16px;"/>
                                </HBox>
                            </VBox>
                        </GridPane>
                    </VBox>
                </VBox>

                <VBox spacing="12">
                    <Label text="Message du candidat"
                           style="-fx-font-size: 16px; -fx-font-weight: 700; -fx-text-fill: #111827;"/>
                    
                    <VBox spacing="0" style="-fx-background-color: white; -fx-padding: 24; -fx-background-radius: 12; -fx-border-color: #e5e7eb; -fx-border-width: 1;">
                        <TextArea fx:id="messageCandidat" promptText="Saisissez le message du candidat..."
                                  prefRowCount="5" wrapText="true"
                                  style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #cbd5e1; -fx-background-color: white; -fx-font-size: 13px; -fx-padding: 12; -fx-control-inner-background: white;"/>
                    </VBox>
                </VBox>

                <Label fx:id="errorLabel" text=""
                       style="-fx-text-fill: #ef4444; -fx-font-size: 13px; -fx-font-weight: 500;"
                       wrapText="true" visible="false" managed="false"/>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox spacing="14" alignment="CENTER_RIGHT" style="-fx-background-color: white; -fx-padding: 20 30; -fx-border-color: #e5e7eb; -fx-border-width: 1 0 0 0;">
            <Button text="Annuler" onAction="#annuler" styleClass="btn-secondary"/>
            <Button fx:id="btnSauvegarder" text="💾 Enregistrer" onAction="#sauvegarder" styleClass="btn-primary"/>
        </HBox>
    </bottom>
</BorderPane>