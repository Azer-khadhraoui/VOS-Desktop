<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane prefHeight="650.0" prefWidth="800.0"
            stylesheets="@../../css/modernRecrutement.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="vos.gestionCandidat.controllers.FormPreferenceAdminController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: white; -fx-padding: 20 30; -fx-border-color: #e5e7eb; -fx-border-width: 0 0 1 0;">
            <Label text="📋 Préférences du candidat"
                   style="-fx-font-size: 16px; -fx-font-weight: 700; -fx-text-fill: #111827;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="candidatureLabel" text=""
                   style="-fx-font-size: 13px; -fx-text-fill: #2563eb; -fx-font-weight: 600;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="20" style="-fx-background-color: #f8fafc; -fx-padding: 30;">

            <Label fx:id="noPreferenceLabel" text="Chargement..."
                   style="-fx-font-size: 14px; -fx-text-fill: #94a3b8;"/>

            <ScrollPane fx:id="contentPane" fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;">
                <VBox spacing="20" style="-fx-padding: 10;">

                    <VBox spacing="12">
                        <Label text="🎯 Poste souhaité"
                               style="-fx-font-size: 15px; -fx-font-weight: 700; -fx-text-fill: #111827;"/>

                        <VBox spacing="0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; -fx-border-color: #e5e7eb; -fx-border-width: 1;">
                            <GridPane hgap="20" vgap="16">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                                </columnConstraints>

                                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <Label text="Type de poste souhaité"
                                           style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #94a3b8;"/>
                                    <Label fx:id="typePosteLabel" text="—"
                                           style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #111827;"/>
                                </VBox>

                                <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <Label text="Mode de travail"
                                           style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #94a3b8;"/>
                                    <Label fx:id="modeTravailLabel" text="—"
                                           style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #111827;"/>
                                </VBox>

                                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                    <Label text="Type de contrat souhaité"
                                           style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #94a3b8;"/>
                                    <Label fx:id="typeContratLabel" text="—"
                                           style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #111827;"/>
                                </VBox>
                            </GridPane>
                        </VBox>
                    </VBox>

                    <VBox spacing="12">
                        <Label text="📅 Disponibilité"
                               style="-fx-font-size: 15px; -fx-font-weight: 700; -fx-text-fill: #111827;"/>

                        <VBox spacing="0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; -fx-border-color: #e5e7eb; -fx-border-width: 1;">
                            <GridPane hgap="20" vgap="16">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                                </columnConstraints>

                                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <Label text="Disponibilité"
                                           style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #94a3b8;"/>
                                    <Label fx:id="disponibiliteLabel" text="—"
                                           style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #111827;"/>
                                </VBox>

                                <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <Label text="Date de disponibilité"
                                           style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #94a3b8;"/>
                                    <Label fx:id="dateDispoLabel" text="—"
                                           style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #111827;"/>
                                </VBox>
                            </GridPane>
                        </VBox>
                    </VBox>

                    <VBox spacing="12">
                        <Label text="🌍 Mobilité géographique"
                               style="-fx-font-size: 15px; -fx-font-weight: 700; -fx-text-fill: #111827;"/>

                        <VBox spacing="0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; -fx-border-color: #e5e7eb; -fx-border-width: 1;">
                            <GridPane hgap="20" vgap="16">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                                </columnConstraints>

                                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <Label text="Mobilité géographique"
                                           style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #94a3b8;"/>
                                    <Label fx:id="mobiliteLabel" text="—"
                                           style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #111827;"/>
                                </VBox>

                                <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <Label text="Prêt à déplacement"
                                           style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #94a3b8;"/>
                                    <Label fx:id="depLabel" text="—"
                                           style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #111827;"/>
                                </VBox>
                            </GridPane>
                        </VBox>
                    </VBox>

                    <VBox spacing="12">
                        <Label text="💰 Prétention salariale"
                               style="-fx-font-size: 15px; -fx-font-weight: 700; -fx-text-fill: #111827;"/>

                        <VBox spacing="0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; -fx-border-color: #e5e7eb; -fx-border-width: 1;">
                            <Label fx:id="salaireLabel" text="—"
                                   style="-fx-font-size: 16px; -fx-font-weight: 700; -fx-text-fill: #10b981;"/>
                        </VBox>
                    </VBox>

                </VBox>
            </ScrollPane>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" style="-fx-background-color: white; -fx-padding: 20 30; -fx-border-color: #e5e7eb; -fx-border-width: 1 0 0 0;">
            <Button fx:id="btnFermer" text="Fermer" onAction="#fermer"
                    style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-font-size: 14px; -fx-font-weight: 600; -fx-padding: 13 30; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-width: 1.5; -fx-border-radius: 8; -fx-cursor: hand; -fx-pref-width: 140;"/>
        </HBox>
    </bottom>
</BorderPane>