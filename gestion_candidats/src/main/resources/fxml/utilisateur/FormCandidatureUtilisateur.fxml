<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.lang.String?>
<?import javafx.collections.FXCollections?>

<BorderPane prefHeight="800.0" prefWidth="1100.0"
    stylesheets="@../../css/style.css"
    xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="vos.gestionCandidat.controllers.FormCandidatureUtilisateurController"
    style="-fx-background-color: #1a1a2e;">

    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <VBox spacing="0" styleClass="form-container">

                <!-- En-tête avec bouton retour et breadcrumb -->
                <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 0 0 25 0;">
                    <Button text="← Retour" onAction="#retour"
                        style="-fx-background-color: transparent; -fx-text-fill: #a855f7; -fx-font-size: 14px; -fx-font-weight: 700; -fx-cursor: hand; -fx-border-width: 0; -fx-padding: 0;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label text="Offres  >  Postuler"
                        style="-fx-text-fill: #6b7280; -fx-font-size: 12px;" />
                </HBox>

                <!-- Carte d'en-tête avec gradient -->
                <HBox spacing="20" alignment="CENTER_LEFT" styleClass="gradient-header"
                    style="-fx-margin: 0 0 30 0;">
                    <Label text="📝" style="-fx-font-size: 40px;" />
                    <VBox spacing="6">
                        <Label fx:id="formTitle" text="Postuler à une offre"
                            styleClass="main-title" />
                        <Label fx:id="offreLabel" text=""
                            style="-fx-font-size: 14px; -fx-text-fill: #a855f7; -fx-font-weight: 600;" />
                    </VBox>
                </HBox>

                <!-- Stepper modernisé -->
                <HBox spacing="0" alignment="CENTER" style="-fx-padding: 0 0 35 0;" maxWidth="700">
                    <VBox alignment="CENTER" spacing="8">
                        <StackPane styleClass="step-circle">
                            <Label text="1" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15px;" />
                        </StackPane>
                        <Label text="Mon profil" styleClass="step-label" />
                    </VBox>
                    <Region styleClass="step-line" HBox.hgrow="ALWAYS" />
                    <VBox alignment="CENTER" spacing="8">
                        <StackPane styleClass="step-circle">
                            <Label text="2" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15px;" />
                        </StackPane>
                        <Label text="Documents" styleClass="step-label" />
                    </VBox>
                    <Region styleClass="step-line inactive" HBox.hgrow="ALWAYS" />
                    <VBox alignment="CENTER" spacing="8">
                        <StackPane styleClass="step-circle inactive">
                            <Label text="3" style="-fx-font-weight: bold; -fx-font-size: 15px;" />
                        </StackPane>
                        <Label text="Message" styleClass="step-label inactive" />
                    </VBox>
                </HBox>

                <!-- Carte principale du formulaire -->
                <VBox spacing="35" styleClass="section-card">

                    <!-- Section Expérience -->
                    <VBox spacing="18">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label text="👤" style="-fx-font-size: 20px;" />
                            <Label text="Votre expérience professionnelle"
                                styleClass="section-title" />
                        </HBox>
                        <Separator styleClass="modern-separator" />

                        <GridPane hgap="24" vgap="20">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="50" />
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="50" />
                            </columnConstraints>

                            <!-- Niveau d'expérience -->
                            <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="NIVEAU D'EXPÉRIENCE *" styleClass="field-label" />
                                <ComboBox fx:id="niveauExperience" maxWidth="Infinity"
                                    promptText="Sélectionner votre niveau..."
                                    styleClass="modern-combo-box"
                                    style="-fx-pref-height: 48;">
                                    <items>
                                        <FXCollections fx:factory="observableArrayList">
                                            <String fx:value="Débutant" />
                                            <String fx:value="Junior" />
                                            <String fx:value="Intermédiaire" />
                                            <String fx:value="Senior" />
                                            <String fx:value="Expert" />
                                        </FXCollections>
                                    </items>
                                </ComboBox>
                                <Label fx:id="errNiveauExp" text="" styleClass="error-label"
                                    visible="false" managed="false" />
                            </VBox>

                            <!-- Années d'expérience -->
                            <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="ANNÉES D'EXPÉRIENCE" styleClass="field-label" />
                                <Spinner fx:id="anneesExperience" min="0" max="50" initialValue="0"
                                    editable="true" maxWidth="Infinity"
                                    styleClass="modern-spinner"
                                    style="-fx-pref-height: 48;" />
                            </VBox>

                            <!-- Domaine d'expérience -->
                            <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <Label text="DOMAINE D'EXPÉRIENCE *" styleClass="field-label" />
                                <ComboBox fx:id="domaineExperience" maxWidth="Infinity"
                                    promptText="Sélectionner un domaine..."
                                    styleClass="modern-combo-box"
                                    style="-fx-pref-height: 48;">
                                    <items>
                                        <FXCollections fx:factory="observableArrayList">
                                            <String fx:value="Développement Web" />
                                            <String fx:value="Développement Mobile" />
                                            <String fx:value="Data Science" />
                                            <String fx:value="DevOps" />
                                            <String fx:value="Cybersécurité" />
                                            <String fx:value="Machine Learning" />
                                            <String fx:value="Cloud Architecture" />
                                            <String fx:value="Marketing Digital" />
                                            <String fx:value="Autre" />
                                        </FXCollections>
                                    </items>
                                </ComboBox>
                                <Label fx:id="errDomaineExp" text="" styleClass="error-label"
                                    visible="false" managed="false" />
                            </VBox>

                            <!-- Dernier poste -->
                            <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                <Label text="DERNIER POSTE OCCUPÉ" styleClass="field-label" />
                                <ComboBox fx:id="dernierPoste" maxWidth="Infinity"
                                    promptText="Sélectionner un poste..."
                                    styleClass="modern-combo-box"
                                    style="-fx-pref-height: 48;">
                                    <items>
                                        <FXCollections fx:factory="observableArrayList">
                                            <String fx:value="Développeur Backend" />
                                            <String fx:value="Développeur Frontend" />
                                            <String fx:value="Développeur Full-Stack" />
                                            <String fx:value="Développeur Mobile" />
                                            <String fx:value="Data Scientist" />
                                            <String fx:value="DevOps Engineer" />
                                            <String fx:value="Security Engineer" />
                                            <String fx:value="Product Manager" />
                                            <String fx:value="Scrum Master" />
                                            <String fx:value="Autre" />
                                        </FXCollections>
                                    </items>
                                </ComboBox>
                            </VBox>
                        </GridPane>
                    </VBox>

                    <!-- Section Documents -->
                    <VBox spacing="18">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label text="📎" style="-fx-font-size: 20px;" />
                            <Label text="Vos documents"
                                styleClass="section-title" />
                        </HBox>
                        <Separator styleClass="modern-separator" />

                        <GridPane hgap="24" vgap="20">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="50" />
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="50" />
                            </columnConstraints>

                            <!-- CV -->
                            <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="CV (CHEMIN / URL)" styleClass="field-label"/>
                                <HBox spacing="10">
                                    <TextField fx:id="cv" promptText="Chemin vers votre CV..."
                                               styleClass="modern-text-field"
                                               HBox.hgrow="ALWAYS"/>
                                    <Button text="📎" onAction="#parcourirCv"
                                            styleClass="file-button"/>
                                </HBox>
                                <Label fx:id="errCv" text="" styleClass="error-label"
                                    visible="false" managed="false" />
                            </VBox>

                            <!-- Lettre de motivation -->
                            <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="LETTRE DE MOTIVATION" styleClass="field-label"/>
                                <HBox spacing="10">
                                    <TextField fx:id="lettreMotivation" promptText="Chemin vers la lettre..."
                                               styleClass="modern-text-field"
                                               HBox.hgrow="ALWAYS"/>
                                    <Button text="📎" onAction="#parcourirLettre"
                                            styleClass="file-button"/>
                                </HBox>
                            </VBox>
                        </GridPane>
                    </VBox>

                    <!-- Section Message -->
                    <VBox spacing="14">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label text="✉️" style="-fx-font-size: 20px;" />
                            <Label text="Message de motivation"
                                styleClass="section-title" />
                        </HBox>
                        <Separator styleClass="modern-separator" />
                        <Label
                            text="Présentez-vous brièvement et expliquez pourquoi vous êtes le candidat idéal pour ce poste."
                            style="-fx-font-size: 13px; -fx-text-fill: #94a3b8;" wrapText="true" />
                        <TextArea fx:id="messageCandidat"
                            promptText="Bonjour, je me permets de vous soumettre ma candidature pour ce poste..."
                            prefRowCount="6" wrapText="true"
                            styleClass="modern-text-area"
                            style="-fx-font-size: 14px; -fx-padding: 16;" />
                    </VBox>

                    <!-- Message d'erreur global -->
                    <Label fx:id="errorLabel" text="" styleClass="error-label"
                        style="-fx-background-color: #2d1f1f; -fx-background-radius: 10; -fx-padding: 14 18; -fx-border-color: #ef4444; -fx-border-width: 1.5; -fx-border-radius: 10; -fx-font-size: 13px;"
                        wrapText="true" visible="false" managed="false" />

                    <!-- Boutons d'action -->
                    <HBox spacing="16" alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
                        <Button text="Annuler" onAction="#retour"
                            styleClass="secondary-button" 
                            style="-fx-pref-width: 150;" />
                        <Button fx:id="btnSoumettre" text="🚀 Soumettre ma candidature"
                            onAction="#soumettreForm"
                            styleClass="primary-button"
                            style="-fx-pref-width: 280;" />
                    </HBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
