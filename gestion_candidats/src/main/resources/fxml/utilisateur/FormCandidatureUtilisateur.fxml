<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<BorderPane prefHeight="800.0" prefWidth="1100.0"
    stylesheets="@../../css/styleoffre.css"
    xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="vos.gestionCandidat.controllers.FormCandidatureUtilisateurController">

    <left>
        <VBox styleClass="sidebar" spacing="25" alignment="TOP_CENTER" prefWidth="90">
            <padding>
                <Insets top="25" right="15" bottom="25" left="15" />
            </padding>
            <Label text="VOS" styleClass="logo-text"
                style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
            <VBox spacing="20" alignment="TOP_CENTER" VBox.vgrow="ALWAYS">
                <Button styleClass="sidebar-btn" onAction="#goOffres"
                    style="-fx-background-color: transparent; -fx-background-radius: 12; -fx-min-width: 50; -fx-min-height: 50;">
                    <graphic>
                        <Label text="💼" style="-fx-font-size: 22px;" />
                    </graphic>
                </Button>
                <Button styleClass="sidebar-btn-active"
                    style="-fx-background-color: #EFF6FF; -fx-background-radius: 12; -fx-min-width: 50; -fx-min-height: 50;">
                    <graphic>
                        <Label text="📋" style="-fx-font-size: 22px;" />
                    </graphic>
                </Button>
                <Button styleClass="sidebar-btn"
                    style="-fx-background-color: transparent; -fx-background-radius: 12; -fx-min-width: 50; -fx-min-height: 50;">
                    <graphic>
                        <Label text="💬" style="-fx-font-size: 22px;" />
                    </graphic>
                </Button>
            </VBox>
            <Button styleClass="sidebar-btn"
                style="-fx-background-color: transparent; -fx-background-radius: 12; -fx-min-width: 50; -fx-min-height: 50;">
                <graphic>
                    <Label text="👤" style="-fx-font-size: 22px;" />
                </graphic>
            </Button>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true"
            style="-fx-background-color: #f8fafc; -fx-border-color: transparent;">
            <VBox spacing="0" style="-fx-background-color: #f8fafc; -fx-padding: 35 60 50 60;">

                <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 0 0 25 0;">
                    <Button text="← Retour à mes candidatures" onAction="#retour"
                        styleClass="back-button"
                        style="-fx-background-color: transparent; -fx-text-fill: #6366f1; -fx-font-size: 14px; -fx-font-weight: 700; -fx-cursor: hand; -fx-border-color: transparent; -fx-padding: 0;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <!-- Breadcrumb -->
                    <Label text="Offres  >  Postuler"
                        style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;" />
                </HBox>

                <HBox spacing="20" alignment="CENTER_LEFT"
                    style="-fx-background-color: linear-gradient(to right, #eef2ff 0%, #f5f3ff 100%); -fx-background-radius: 16; -fx-padding: 24 30; -fx-margin: 0 0 25 0; -fx-border-color: #e0e7ff; -fx-border-width: 1; -fx-border-radius: 16;">
                    <Label text="📝" style="-fx-font-size: 36px;" />
                    <VBox spacing="4">
                        <Label fx:id="formTitle" text="Postuler à une offre"
                            style="-fx-font-size: 22px; -fx-font-weight: 800; -fx-text-fill: #0f172a;" />
                        <Label fx:id="offreLabel" text=""
                            style="-fx-font-size: 14px; -fx-text-fill: #6366f1; -fx-font-weight: 600;" />
                    </VBox>
                </HBox>

                <HBox spacing="0" alignment="CENTER" style="-fx-padding: 0 0 30 0;" maxWidth="700">
                    <VBox alignment="CENTER" spacing="6">
                        <StackPane>
                            <Label text="1"
                                style="-fx-background-color: #6366f1; -fx-text-fill: white; -fx-background-radius: 50; -fx-min-width: 32; -fx-min-height: 32; -fx-max-width: 32; -fx-max-height: 32; -fx-alignment: center; -fx-font-weight: bold; -fx-font-size: 14px;" />
                        </StackPane>
                        <Label text="Mon profil"
                            style="-fx-font-size: 11px; -fx-text-fill: #6366f1; -fx-font-weight: 600;" />
                    </VBox>
                    <Region
                        style="-fx-background-color: #6366f1; -fx-pref-height: 2; -fx-max-height: 2;"
                        HBox.hgrow="ALWAYS" />
                    <VBox alignment="CENTER" spacing="6">
                        <StackPane>
                            <Label text="2"
                                style="-fx-background-color: #6366f1; -fx-text-fill: white; -fx-background-radius: 50; -fx-min-width: 32; -fx-min-height: 32; -fx-max-width: 32; -fx-max-height: 32; -fx-alignment: center; -fx-font-weight: bold; -fx-font-size: 14px;" />
                        </StackPane>
                        <Label text="Documents"
                            style="-fx-font-size: 11px; -fx-text-fill: #6366f1; -fx-font-weight: 600;" />
                    </VBox>
                    <Region
                        style="-fx-background-color: #e2e8f0; -fx-pref-height: 2; -fx-max-height: 2;"
                        HBox.hgrow="ALWAYS" />
                    <VBox alignment="CENTER" spacing="6">
                        <StackPane>
                            <Label text="3"
                                style="-fx-background-color: #e2e8f0; -fx-text-fill: #94a3b8; -fx-background-radius: 50; -fx-min-width: 32; -fx-min-height: 32; -fx-max-width: 32; -fx-max-height: 32; -fx-alignment: center; -fx-font-weight: bold; -fx-font-size: 14px;" />
                        </StackPane>
                        <Label text="Message" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;" />
                    </VBox>
                </HBox>

                <VBox spacing="28"
                    style="-fx-background-color: white; -fx-padding: 40; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 20, 0, 0, 6);">

                    <VBox spacing="16">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="👤" style="-fx-font-size: 18px;" />
                            <Label text="Votre expérience professionnelle"
                                style="-fx-font-size: 16px; -fx-font-weight: 700; -fx-text-fill: #0f172a;" />
                        </HBox>
                        <Separator style="-fx-background-color: #e2e8f0;" />

                        <GridPane hgap="20" vgap="16">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="50" />
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="50" />
                            </columnConstraints>

                            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="Niveau d'expérience *"
                                    style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #374151;" />
                                <ComboBox fx:id="niveauExperience" maxWidth="Infinity"
                                    promptText="Sélectionner..."
                                    style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #e2e8f0; -fx-background-color: white; -fx-pref-height: 44;">
                                    <items>
                                        <FXCollections fx:factory="observableArrayList">
                                            <String fx:value="Débutant" />
                                            <String fx:value="Junior" />
                                            <String fx:value="Intermédiaire" />
                                            <String fx:value="Senior" />
                                            <String fx:value="Expert" />
                                        </FXCollections>
                                    </items>
                                </ComboBox>
                                <Label fx:id="errNiveauExp" text=""
                                    style="-fx-text-fill: #ef4444; -fx-font-size: 11px; -fx-padding: 2 0 0 4;"
                                    visible="false" managed="false" />
                            </VBox>

                            <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="Nombre d'années d'expérience"
                                    style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #374151;" />
                                <Spinner fx:id="anneesExperience" min="0" max="50" initialValue="0"
                                    editable="true" maxWidth="Infinity"
                                    style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #e2e8f0; -fx-background-color: white; -fx-pref-height: 44;" />
                            </VBox>

                            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <Label text="Domaine d'expérience *"
                                    style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #374151;" />
                                <ComboBox fx:id="domaineExperience" maxWidth="Infinity"
                                    promptText="Sélectionner..."
                                    style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #e2e8f0; -fx-background-color: white; -fx-pref-height: 44;">
                                    <items>
                                        <FXCollections fx:factory="observableArrayList">
                                            <String fx:value="Développement Web" />
                                            <String fx:value="Développement Mobile" />
                                            <String fx:value="Data Science" />
                                            <String fx:value="DevOps" />
                                            <String fx:value="Cybersécurité" />
                                            <String fx:value="Machine Learning" />
                                            <String fx:value="Cloud Architecture" />
                                            <String fx:value="Marketing Digital" />
                                            <String fx:value="Autre" />
                                        </FXCollections>
                                    </items>
                                </ComboBox>
                                <Label fx:id="errDomaineExp" text=""
                                    style="-fx-text-fill: #ef4444; -fx-font-size: 11px; -fx-padding: 2 0 0 4;"
                                    visible="false" managed="false" />
                            </VBox>

                            <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                <Label text="Dernier poste occupé"
                                    style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #374151;" />
                                <ComboBox fx:id="dernierPoste" maxWidth="Infinity"
                                    promptText="Sélectionner..."
                                    style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #e2e8f0; -fx-background-color: white; -fx-pref-height: 44;">
                                    <items>
                                        <FXCollections fx:factory="observableArrayList">
                                            <String fx:value="Développeur Backend" />
                                            <String fx:value="Développeur Frontend" />
                                            <String fx:value="Développeur Full-Stack" />
                                            <String fx:value="Développeur Mobile" />
                                            <String fx:value="Data Scientist" />
                                            <String fx:value="DevOps Engineer" />
                                            <String fx:value="Security Engineer" />
                                            <String fx:value="Product Manager" />
                                            <String fx:value="Scrum Master" />
                                            <String fx:value="Autre" />
                                        </FXCollections>
                                    </items>
                                </ComboBox>
                                <Label fx:id="errDomaineExp" text=""
                                    style="-fx-text-fill: #ef4444; -fx-font-size: 11px; -fx-padding: 2 0 0 4;"
                                    visible="false" managed="false" />
                            </VBox>
                        </GridPane>
                    </VBox>

                    <VBox spacing="16">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="📎" style="-fx-font-size: 18px;" />
                            <Label text="Vos documents"
                                style="-fx-font-size: 16px; -fx-font-weight: 700; -fx-text-fill: #0f172a;" />
                        </HBox>
                        <Separator style="-fx-background-color: #e2e8f0;" />

                        <GridPane hgap="20" vgap="16">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="50" />
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="50" />
                            </columnConstraints>

                            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="CV *"
                                    style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #374151;" />
                                <VBox spacing="8"
                                    style="-fx-background-color: #fafafa; -fx-background-radius: 10; -fx-border-color: dashed #c7d2fe; -fx-border-width: 2; -fx-border-radius: 10; -fx-padding: 14 16; -fx-cursor: hand;"
                                    onMouseClicked="#parcourirCv">
                                    <Label text="📄 Glisser votre CV ici ou cliquer"
                                        style="-fx-text-fill: #6366f1; -fx-font-size: 13px; -fx-font-weight: 600;" />
                                    <Label fx:id="cvFileName" text="Aucun fichier sélectionné"
                                        style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;" />
                                    <TextField fx:id="cv" visible="false" managed="false" />
                                </VBox>
                                <Label fx:id="errCv" text=""
                                    style="-fx-text-fill: #ef4444; -fx-font-size: 11px; -fx-padding: 2 0 0 4;"
                                    visible="false" managed="false" />
                            </VBox>

                            <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="Lettre de motivation"
                                    style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #374151;" />
                                <VBox spacing="8"
                                    style="-fx-background-color: #fafafa; -fx-background-radius: 10; -fx-border-color: dashed #c7d2fe; -fx-border-width: 2; -fx-border-radius: 10; -fx-padding: 14 16; -fx-cursor: hand;"
                                    onMouseClicked="#parcourirLettre">
                                    <Label text="📝 Glisser votre lettre ici ou cliquer"
                                        style="-fx-text-fill: #6366f1; -fx-font-size: 13px; -fx-font-weight: 600;" />
                                    <Label fx:id="lettreFileName" text="Aucun fichier sélectionné"
                                        style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;" />
                                    <TextField fx:id="lettreMotivation" visible="false"
                                        managed="false" />
                                </VBox>
                            </VBox>
                        </GridPane>
                    </VBox>

                    <VBox spacing="12">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="✉️" style="-fx-font-size: 18px;" />
                            <Label text="Message de motivation"
                                style="-fx-font-size: 16px; -fx-font-weight: 700; -fx-text-fill: #0f172a;" />
                        </HBox>
                        <Separator style="-fx-background-color: #e2e8f0;" />
                        <Label
                            text="Présentez-vous brièvement et expliquez pourquoi vous êtes le candidat idéal."
                            style="-fx-font-size: 13px; -fx-text-fill: #64748b;" wrapText="true" />
                        <TextArea fx:id="messageCandidat"
                            promptText="Bonjour, je me permets de vous soumettre ma candidature pour ce poste..."
                            prefRowCount="5" wrapText="true"
                            style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #e2e8f0; -fx-background-color: white; -fx-font-size: 14px; -fx-padding: 14;" />
                    </VBox>

                    <Label fx:id="errorLabel" text=""
                        style="-fx-text-fill: #ef4444; -fx-font-size: 13px; -fx-background-color: #fef2f2; -fx-background-radius: 8; -fx-padding: 10 14; -fx-border-color: #fecaca; -fx-border-width: 1; -fx-border-radius: 8;"
                        wrapText="true" visible="false" managed="false" />

                    <HBox spacing="14" alignment="CENTER_RIGHT" style="-fx-padding: 8 0 0 0;">
                        <Button text="Annuler" onAction="#retour"
                            style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-font-size: 14px; -fx-font-weight: 600; -fx-padding: 13 30; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-width: 1.5; -fx-border-radius: 10; -fx-cursor: hand; -fx-pref-width: 140;" />
                        <Button fx:id="btnSoumettre" text="🚀 Soumettre ma candidature"
                            onAction="#soumettreForm"
                            style="-fx-background-color: linear-gradient(to right, #6366f1 0%, #8b5cf6 100%); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: 700; -fx-padding: 13 30; -fx-background-radius: 10; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(99,102,241,0.4), 12, 0, 0, 4); -fx-pref-width: 250;" />
                    </HBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>