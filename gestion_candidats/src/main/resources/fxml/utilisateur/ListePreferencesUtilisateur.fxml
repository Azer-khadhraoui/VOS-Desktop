<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.*?>

<BorderPane prefHeight="800.0" prefWidth="1300.0"
            stylesheets="@../../css/modernRecrutement.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="vos.gestionCandidat.controllers.ListePreferencesUtilisateurController">

    <left>
        <VBox fx:id="sidebar" styleClass="sidebar" prefWidth="60.0" minWidth="60.0" maxWidth="240.0"
              onMouseEntered="#onSidebarEntered" onMouseExited="#onSidebarExited">

            <VBox alignment="CENTER" styleClass="sidebar-logo">
                <padding>
                    <Insets top="15.0" bottom="15.0"/>
                </padding>
                <ImageView fitHeight="60.0" fitWidth="60.0" preserveRatio="true">
                    <image>
                        <Image url="@../../images/VOSwhite.png"/>
                    </image>
                </ImageView>
            </VBox>

            <VBox alignment="TOP_CENTER" spacing="12.0" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets top="10.0" left="6.0" right="6.0"/>
                </padding>

                <HBox fx:id="navCandidatures" styleClass="sidebar-nav-item">
                    <Label styleClass="sidebar-nav-icon" text="📋"/>
                    <Label fx:id="navCandidaturesText" styleClass="sidebar-nav-label" text="Mes Candidatures"/>
                </HBox>

                <HBox fx:id="navPreferences" styleClass="sidebar-nav-item, sidebar-nav-item-active">
                    <Label styleClass="sidebar-nav-icon" text="⭐"/>
                    <Label fx:id="navPreferencesText" styleClass="sidebar-nav-label" text="Mes Préférences"/>
                </HBox>

                <HBox fx:id="navOffres" styleClass="sidebar-nav-item">
                    <Label styleClass="sidebar-nav-icon" text="💼"/>
                    <Label fx:id="navOffresText" styleClass="sidebar-nav-label" text="Offres"/>
                </HBox>

                <HBox fx:id="navForum" styleClass="sidebar-nav-item">
                    <Label styleClass="sidebar-nav-icon" text="💬"/>
                    <Label fx:id="navForumText" styleClass="sidebar-nav-label" text="Forum"/>
                </HBox>
            </VBox>

            <VBox VBox.vgrow="ALWAYS"/>

            <HBox fx:id="navProfil" styleClass="sidebar-nav-item">
                <Label styleClass="sidebar-nav-icon" text="👤"/>
                <Label fx:id="navProfilText" styleClass="sidebar-nav-label" text="Mon Profil"/>
            </HBox>

            <VBox style="-fx-min-height: 8.0;"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="0" VBox.vgrow="ALWAYS">
            <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="20.0">
                <padding>
                    <Insets top="20.0" right="30.0" bottom="20.0" left="30.0"/>
                </padding>

                <Label text="Mes Préférences de Candidature" styleClass="page-title" style="-fx-font-size: 20px;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <HBox spacing="15.0" alignment="CENTER">
                    <StackPane style="-fx-background-color: linear-gradient(to bottom right, #667eea, #764ba2); -fx-background-radius: 20; -fx-pref-width: 40; -fx-pref-height: 40;">
                        <Label text="U" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    </StackPane>
                    <VBox alignment="CENTER_LEFT" spacing="2.0">
                        <Label text="Utilisateur" styleClass="user-name"/>
                        <Label text="Candidat" styleClass="user-role"/>
                    </VBox>
                </HBox>
            </HBox>

            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;" 
                        VBox.vgrow="ALWAYS">
                <VBox fx:id="mainView" spacing="30" alignment="TOP_CENTER"
                      style="-fx-padding: 30; -fx-background-color: white;">

                    <!-- Hero Section -->
                    <VBox styleClass="hero" spacing="16" alignment="CENTER_LEFT" maxWidth="900"
                          style="-fx-background-color: #8b5cf6; -fx-background-radius: 25; -fx-padding: 40 50; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 25, 0, 0, 10);">
                        <Label text="⭐ Mes Préférences"
                               style="-fx-text-fill: white; -fx-font-size: 34px; -fx-font-weight: 800;"/>
                        <Label fx:id="heroSubtitle" text="Voici vos préférences de candidature"
                               style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 16px;"/>
                    </VBox>

                    <!-- Boutons d'action -->
                    <HBox spacing="15" alignment="CENTER_LEFT" maxWidth="900">
                        <Button text="← Retour à mes candidatures" onAction="#retournerAuxCandidatures"
                                style="-fx-background-color: #e5e7eb; -fx-text-fill: #374151; -fx-background-radius: 12; -fx-padding: 12 24; -fx-font-weight: 700; -fx-cursor: hand;"/>
                        <Button text="➕ Ajouter une préférence" onAction="#ajouterPreference"
                                style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 12; -fx-padding: 12 24; -fx-font-weight: 700; -fx-cursor: hand;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                    </HBox>

                    <!-- Conteneur des cards -->
                    <VBox fx:id="preferencesContainer" spacing="16" maxWidth="900"
                          style="-fx-padding: 0 0 20 0;">
                        <!-- Les cards seront générées dynamiquement -->
                    </VBox>

                    <!-- État vide -->
                    <VBox fx:id="emptyState" visible="false" managed="false"
                          alignment="CENTER" spacing="16" maxWidth="900"
                          style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 60 40; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 15, 0, 0, 5); -fx-border-color: #e5e7eb; -fx-border-width: 1;">
                        <Label text="⭐" style="-fx-font-size: 52px;"/>
                        <Label text="Aucune préférence enregistrée"
                               style="-fx-font-size: 18px; -fx-font-weight: 700; -fx-text-fill: #0f172a;"/>
                        <Label text="Créez une préférence de candidature pour vous aider"
                               style="-fx-font-size: 14px; -fx-text-fill: #64748b;"/>
                        <Button text="Créer une préférence" onAction="#ajouterPreference"
                                style="-fx-background-color: linear-gradient(to right, #8b5cf6 0%, #a855f7 100%); -fx-text-fill: white; -fx-background-radius: 12; -fx-padding: 12 30; -fx-font-weight: 700; -fx-cursor: hand;"/>
                    </VBox>
                </VBox>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>