<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="vos.gestionCandidat.controllers.MatchingUtilisateurController"
      spacing="0" style="-fx-background-color: #F5F7FA;">

    <!-- ═══ HEADER ══════════════════════════════════════════════════════════ -->
    <HBox style="-fx-background-color: #2C3E50; -fx-padding: 18 24 18 24;"
          alignment="CENTER_LEFT" spacing="12">
        <Label text="🎯 Offres compatibles avec mes préférences"
               style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblNombreOffres" text="—"
               style="-fx-text-fill: #BDC3C7; -fx-font-size: 13px;"/>
        <Button fx:id="btnActualiser" text="🔄 Actualiser"
                onAction="#onActualiser"
                style="-fx-background-color: #3498DB; -fx-text-fill: white;
                       -fx-padding: 6 14; -fx-background-radius: 6; -fx-cursor: hand;"/>
    </HBox>

    <!-- ═══ RÉSUMÉ DES PRÉFÉRENCES ══════════════════════════════════════════ -->
    <VBox style="-fx-background-color: #EBF5FB; -fx-padding: 12 24 12 24;
                 -fx-border-color: #AED6F1; -fx-border-width: 0 0 1 0;" spacing="6">
        <Label text="📋 Mes préférences utilisées pour le matching"
               style="-fx-font-weight: bold; -fx-text-fill: #1A5276; -fx-font-size: 13px;"/>
        <HBox spacing="20" alignment="CENTER_LEFT">
            <Label fx:id="lblProfilPoste"
                   style="-fx-font-size: 12px; -fx-text-fill: #2874A6;"/>
            <Label fx:id="lblProfilContrat"
                   style="-fx-font-size: 12px; -fx-text-fill: #2874A6;"/>
            <Label fx:id="lblProfilMode"
                   style="-fx-font-size: 12px; -fx-text-fill: #2874A6;"/>
            <Label fx:id="lblProfilDispo"
                   style="-fx-font-size: 12px; -fx-text-fill: #2874A6;"/>
            <Label fx:id="lblProfilMobilite"
                   style="-fx-font-size: 12px; -fx-text-fill: #2874A6;"/>
        </HBox>
        <Label fx:id="lblProfilStatus"
               style="-fx-font-size: 11px; -fx-text-fill: #7F8C8D;"/>
    </VBox>

    <!-- ═══ FILTRES ══════════════════════════════════════════════════════════ -->
    <HBox style="-fx-background-color: white; -fx-padding: 10 24 10 24;
                 -fx-border-color: #D5D8DC; -fx-border-width: 0 0 1 0;"
          spacing="16" alignment="CENTER_LEFT">
        <Label text="Niveau :" style="-fx-font-weight: bold; -fx-font-size: 13px;"/>
        <ComboBox fx:id="cmbFiltreNiveau" onAction="#onFiltrerNiveau"
                  style="-fx-pref-width: 160px;"/>
        <Separator orientation="VERTICAL"/>
        <Label text="Score min :" style="-fx-font-weight: bold; -fx-font-size: 13px;"/>
        <Slider fx:id="sliderScoreMin" min="0" max="100" value="0"
                showTickLabels="true" majorTickUnit="25" style="-fx-pref-width: 160px;"/>
        <Label fx:id="lblScoreMinVal" text="0%"
               style="-fx-font-size: 12px; -fx-text-fill: #7F8C8D;"/>
    </HBox>

    <!-- ═══ LISTE DES RÉSULTATS ══════════════════════════════════════════════ -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background: #F5F7FA; -fx-background-color: #F5F7FA;">
        <VBox fx:id="vboxResultats" spacing="12"
              style="-fx-padding: 20 24 20 24;"/>
    </ScrollPane>

    <!-- ═══ ÉTAT VIDE ════════════════════════════════════════════════════════ -->
    <VBox fx:id="boxEtatVide" alignment="CENTER" spacing="16"
          style="-fx-padding: 60; -fx-background-color: #F5F7FA;"
          visible="false" managed="false">
        <Label text="😔" style="-fx-font-size: 48px;"/>
        <Label text="Aucune offre compatible trouvée"
               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #7F8C8D;"/>
        <Label text="Complétez vos préférences pour activer le matching."
               style="-fx-font-size: 13px; -fx-text-fill: #95A5A6;"/>
        <Button text="📝 Compléter mes préférences" onAction="#onCompleterProfil"
                style="-fx-background-color: #2C3E50; -fx-text-fill: white;
                       -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
    </VBox>

    <!-- ═══ CHARGEMENT ═══════════════════════════════════════════════════════ -->
    <HBox fx:id="boxChargement" alignment="CENTER" spacing="12"
          style="-fx-padding: 20; -fx-background-color: #F5F7FA;"
          visible="false" managed="false">
        <ProgressIndicator style="-fx-pref-width: 30; -fx-pref-height: 30;"/>
        <Label text="Analyse de vos préférences en cours..."
               style="-fx-font-size: 14px; -fx-text-fill: #7F8C8D;"/>
    </HBox>

</VBox>
