<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.*?>

<BorderPane prefHeight="800.0" prefWidth="1300.0"
            stylesheets="@../../css/modernRecrutement.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="vos.gestionCandidat.controllers.MainViewController">

    <!-- SIDEBAR PARTAGÉ -->
    <left>
        <VBox fx:id="sidebar" styleClass="sidebar" prefWidth="60.0" minWidth="60.0" maxWidth="240.0"
              onMouseEntered="#onSidebarEntered" onMouseExited="#onSidebarExited">

            <VBox alignment="CENTER" styleClass="sidebar-logo">
                <padding>
                    <Insets top="15.0" bottom="15.0"/>
                </padding>
                <ImageView fitHeight="60.0" fitWidth="60.0" preserveRatio="true">
                    <image>
                        <Image url="@../../images/VOSwhite.png"/>
                    </image>
                </ImageView>
            </VBox>

            <VBox alignment="TOP_CENTER" spacing="12.0" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets top="10.0" left="6.0" right="6.0" />
                </padding>
                
                <HBox fx:id="navOffres" styleClass="sidebar-nav-item" onMouseClicked="#navToOffres">
                    <Label styleClass="sidebar-nav-icon" text="💼" />
                    <Label fx:id="navOffresText" styleClass="sidebar-nav-label" text="Offres" />
                </HBox>
                
                <HBox fx:id="navMatchings" styleClass="sidebar-nav-item" onMouseClicked="#navToMatching">
                    <Label styleClass="sidebar-nav-icon" text="🎯" />
                    <Label fx:id="navMatchingsText" styleClass="sidebar-nav-label" text="Offres Compatibles" />
                </HBox>
                
                <HBox fx:id="navPreferences" styleClass="sidebar-nav-item" onMouseClicked="#navToPreferences">
                    <Label styleClass="sidebar-nav-icon" text="⭐"/>
                    <Label fx:id="navPreferencesText" styleClass="sidebar-nav-label" text="Mes Préférences"/>
                </HBox>

                <HBox fx:id="navCandidatures" styleClass="sidebar-nav-item" onMouseClicked="#navToCandidatures">
                    <Label styleClass="sidebar-nav-icon" text="📋" />
                    <Label fx:id="navCandidaturesText" styleClass="sidebar-nav-label" text="Mes Candidatures" />
                </HBox>

                <HBox fx:id="navForum" styleClass="sidebar-nav-item" onMouseClicked="#navToForum">
                    <Label styleClass="sidebar-nav-icon" text="💬" />
                    <Label fx:id="navForumText" styleClass="sidebar-nav-label" text="Forum" />
                </HBox>
            </VBox>

            <VBox VBox.vgrow="ALWAYS"/>

            <HBox fx:id="navProfil" styleClass="sidebar-nav-item" onMouseClicked="#navToProfil">
                <Label styleClass="sidebar-nav-icon" text="👤"/>
                <Label fx:id="navProfilText" styleClass="sidebar-nav-label" text="Mon Profil"/>
            </HBox>

            <VBox style="-fx-min-height: 8.0;"/>
        </VBox>
    </left>

    <!-- CONTENU PRINCIPAL - UTILISE STACKPANE POUR SCANNER LES PAGES -->
    <center>
        <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS">
            <!-- Les pages seront chargées dynamiquement ici -->
        </StackPane>
    </center>
</BorderPane>